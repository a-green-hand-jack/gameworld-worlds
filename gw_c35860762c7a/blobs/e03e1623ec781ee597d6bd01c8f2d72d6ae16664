// Everything in a level that moves and is not Mario: enemies, items,
// effects and level objects (flagpole, lifts, fire bars, Bowser).
// Positions are the top-left of the hit box in level pixels; frames are drawn
// by their bottom centre (docs/assets.md).
import { RULES, TILE } from './consts.js';
import { moveBody } from './world.js';

const GRAVITY = 0.375;
const MAX_FALL = 4;

export class Ent {
  constructor(game, x, y, w, h) {
    this.game = game;
    this.x = x; this.y = y; this.w = w; this.h = h;
    this.vx = 0; this.vy = 0;
    this.dead = false;
    this.onGround = false;
    this.t = 0;
  }
  get cx() { return this.x + this.w / 2; }
  get bottom() { return this.y + this.h; }
  overlaps(o, inset = 0) {
    return this.x + inset < o.x + o.w && o.x + inset < this.x + this.w && this.y + inset < o.y + o.h && o.y + inset < this.y + this.h;
  }
  gone() {
    const g = this.game;
    return this.x + this.w < g.camX - 48 || this.y > 272;
  }
  update() {}
  draw() {}
  sprite(ctx, sheet, name, opts = {}) {
    const g = this.game;
    g.assets.draw(ctx, sheet, name, Math.round(this.cx - g.camX), Math.round(this.bottom + (opts.dy || 0)), { variant: g.area.spriteVariant, ...opts });
  }
}

// ---------------------------------------------------------------- enemies

export class Enemy extends Ent {
  constructor(game, x, y, w, h) {
    super(game, x, y, w, h);
    this.enemy = true;
    this.dir = -1;
    this.speed = 0.5;
    this.fireImmune = false;
    this.starImmune = false;
    this.stompable = true;
    this.harmless = false;
  }
  // The box that touches Mario: a little smaller than the tile box.
  hitBox() { return { x: this.x + 2, y: this.y + 4, w: this.w - 4, h: this.h - 4 }; }
  walk(ledgeTurn = false) {
    const area = this.game.area;
    if (ledgeTurn && this.onGround) {
      const ahead = this.dir > 0 ? this.x + this.w : this.x - 1;
      if (!area.solidAtPx(ahead + this.dir * 2, this.bottom + 2)) this.dir = -this.dir;
    }
    this.vx = this.dir * this.speed;
    this.vy = Math.min(this.vy + GRAVITY, MAX_FALL);
    moveBody(this, area);
    if (this.hitWall) this.dir = -this.hitWall;
  }
  // Killed by a fireball, a shell, the star, a bumped block or Bowser's fall:
  // it flips over and drops off the screen.
  flip(score, from = 0) {
    this.dead = true;
    this.game.addEnt(new FlippedCorpse(this.game, this, from));
    if (score) this.game.addScore(score, this.cx, this.y);
  }
  // Returns what a hit of the given kind did.
  stomp() { this.flip(100); return 'kill'; }
}

class FlippedCorpse extends Ent {
  constructor(game, e, from) {
    super(game, e.x, e.y, e.w, e.h);
    this.frameName = e.corpseFrame ? e.corpseFrame() : null;
    this.sheet = e.sheet || 'enemies';
    this.vy = -3;
    this.vx = from ? from * 0.75 : (e.dir || 1) * -0.5;
  }
  update() {
    this.x += this.vx;
    this.vy = Math.min(this.vy + GRAVITY * 0.7, MAX_FALL);
    this.y += this.vy;
    if (this.y > 272) this.dead = true;
  }
  draw(ctx) { if (this.frameName) this.sprite(ctx, this.sheet, this.frameName, { flipV: true }); }
}

export class Goomba extends Enemy {
  constructor(game, x, y) { super(game, x, y, 16, 16); this.flat = 0; }
  update() {
    if (this.flat) { if (--this.flat <= 0) this.dead = true; return; }
    this.walk(false);
  }
  stomp() {
    this.flat = 30;
    this.harmless = true;
    this.game.sfx('stomp');
    return 'stomp';
  }
  corpseFrame() { return 'goomba_walk1'; }
  draw(ctx) {
    const name = this.flat ? 'goomba_flat' : (this.game.frame >> 3) & 1 ? 'goomba_walk2' : 'goomba_walk1';
    this.sprite(ctx, 'enemies', name);
  }
}

// Koopa Troopa (green walks off ledges, red turns at them), Paratroopa
// (opts.para: hops; opts.fly: flies up and down), Buzzy Beetle (beetle).
export class Koopa extends Enemy {
  constructor(game, x, y, opts = {}) {
    const beetle = !!opts.beetle;
    super(game, x, y, 16, beetle ? 16 : 24);
    this.red = !!opts.red;
    this.beetle = beetle;
    this.para = !!opts.para && !opts.fly;
    this.fly = !!opts.fly;
    this.fireImmune = beetle;
    this.baseY = this.y;
    this.shell = false;
    this.wake = 0;
    if (this.fly) this.speed = 0;
  }
  get color() { return this.red ? 'red' : 'green'; }
  update() {
    if (this.shell) return this.updateShell();
    if (this.fly) {
      // red Paratroopa: flies up and down over three tiles and a half
      this.t++;
      this.y = this.baseY + 28 - Math.cos(this.t * Math.PI / 96) * 28;
      return;
    }
    if (this.para) {
      this.vx = this.dir * this.speed;
      this.vy = Math.min(this.vy + 0.15, MAX_FALL);
      moveBody(this, this.game.area);
      if (this.hitWall) this.dir = -this.hitWall;
      if (this.onGround) this.vy = -3.2;
      return;
    }
    this.walk(this.red);
  }
  updateShell() {
    if (this.vx === 0 && this.kick === 0) {
      this.wake--;
      if (this.wake <= 0) {
        // climbs back out of the shell
        this.shell = false;
        this.y -= 8; this.h = 24;
        if (this.beetle) { this.y += 8; this.h = 16; }
        this.harmless = false;
        this.dir = this.game.player.cx < this.cx ? -1 : 1;
      }
      this.vy = Math.min(this.vy + GRAVITY, MAX_FALL);
      moveBody(this, this.game.area);
      return;
    }
    if (this.kickGrace > 0) this.kickGrace--;
    this.vx = this.kick * 3;
    this.vy = Math.min(this.vy + GRAVITY, MAX_FALL);
    moveBody(this, this.game.area);
    if (this.hitWall) {
      this.kick = -this.hitWall;
      if (this.x > this.game.camX - 16 && this.x < this.game.camX + 256) this.game.sfx('bump');
    }
  }
  toShell() {
    if (!this.beetle) { this.y += 8; this.h = 16; }
    this.shell = true;
    this.kick = 0;
    this.vx = 0;
    this.wake = 300;
    this.harmless = false;
  }
  stomp() {
    const g = this.game;
    if (this.fly || this.para) {
      // loses its wings
      this.fly = this.para = false;
      this.speed = 0.5;
      this.dir = g.player.cx < this.cx ? -1 : 1;
      g.sfx('stomp');
      return 'stomp';
    }
    if (!this.shell || this.kick !== 0) {
      this.toShell();
      g.sfx('stomp');
      return 'stomp';
    }
    // stomping a resting shell kicks it
    this.kickShell(g.player.cx < this.cx ? 1 : -1);
    return 'kick';
  }
  kickShell(dir) {
    this.kick = dir;
    this.kickGrace = 8;
    this.shellChain = 0;
    this.game.sfx('kick');
    this.game.addScore(RULES.kickScore, this.cx, this.y);
  }
  get moving() { return this.shell && this.kick !== 0; }
  corpseFrame() { return this.beetle ? 'beetle_shell' : `koopa_${this.color}_shell`; }
  draw(ctx) {
    const flip = this.dir > 0;
    if (this.shell) {
      const waking = this.kick === 0 && this.wake < 64 && (this.game.frame >> 2) & 1;
      const name = this.beetle ? 'beetle_shell' : `koopa_${this.color}_shell${waking ? '_wake' : ''}`;
      return this.sprite(ctx, 'enemies', name);
    }
    const step = (this.game.frame >> 3) & 1 ? 2 : 1;
    if (this.beetle) return this.sprite(ctx, 'enemies', `beetle_walk${step}`, { flip });
    if (this.fly || this.para) return this.sprite(ctx, 'enemies', `paratroopa_${this.color}_fly${step}`, { flip });
    this.sprite(ctx, 'enemies', `koopa_${this.color}_walk${step}`, { flip });
  }
}

// Piranha Plant: rises out of its pipe and sinks back, but does not come out
// while Mario stands on or right next to the pipe.
export class Piranha extends Enemy {
  constructor(game, x, y) {
    super(game, x, y, 16, 24);
    this.topY = y;
    this.y = y + 24;
    this.phase = 'down';
    this.t = 0;
    this.stompable = false;
  }
  hitBox() { return { x: this.x + 3, y: this.y + 4, w: this.w - 6, h: Math.max(0, this.topY + 24 - this.y - 4) }; }
  update() {
    this.t++;
    const p = this.game.player;
    if (this.phase === 'down' && this.t >= 60) {
      if (Math.abs(p.cx - this.cx) > 24 + 8) { this.phase = 'rise'; this.t = 0; } else this.t = 50;
    } else if (this.phase === 'rise') {
      this.y = Math.max(this.topY, this.y - 0.5);
      if (this.y <= this.topY) { this.phase = 'up'; this.t = 0; }
    } else if (this.phase === 'up' && this.t >= 60) {
      this.phase = 'sink'; this.t = 0;
    } else if (this.phase === 'sink') {
      this.y = Math.min(this.topY + 24, this.y + 0.5);
      if (this.y >= this.topY + 24) { this.phase = 'down'; this.t = 0; }
    }
    this.harmless = this.y >= this.topY + 22;
  }
  gone() { return this.x + this.w < this.game.camX - 48; }
  stomp() { return 'hurt'; }
  corpseFrame() { return 'piranha1'; }
  draw(ctx) {
    const g = this.game;
    const clip = this.topY + 24 - g.camY;
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, 256, clip);
    ctx.clip();
    g.assets.draw(ctx, 'enemies', (g.frame >> 3) & 1 ? 'piranha2' : 'piranha1', Math.round(this.cx - g.camX), Math.round(this.y + 24), { variant: g.area.spriteVariant });
    ctx.restore();
  }
  get bottom() { return this.y + 24; }
}

// Podoboo: leaps out of the lava and falls back.
export class Podoboo extends Enemy {
  constructor(game, x, y) {
    super(game, x, 240, 16, 16);
    this.baseY = 240;
    this.wait = 30;
    this.stompable = false;
    this.fireImmune = true;
    this.starImmune = true;
  }
  update() {
    if (this.wait > 0) { this.wait--; this.y = 240; return; }
    this.vy += 0.1;
    this.y += this.vy;
    if (this.y >= 240 && this.vy > 0) { this.wait = 90; this.vy = -5.6; }
  }
  gone() { return this.x + this.w < this.game.camX - 48; }
  stomp() { return 'hurt'; }
  draw(ctx) { if (this.y < 240) this.sprite(ctx, 'enemies', 'podoboo', { flipV: this.vy > 0 }); }
}

// Fire bar: a line of fireballs turning about a block.
export class Firebar extends Enemy {
  constructor(game, x, y, opts = {}) {
    super(game, x, y, 8, 8);
    this.ox = x + 4; this.oy = y + 4;
    this.length = opts.length || 6;
    this.turn = (opts.dir || 1) * (opts.speed === 2 ? 2 : 1);
    this.stompable = false;
    this.fireImmune = true;
    this.starImmune = true;
    this.a = 0;
  }
  update() { this.a = (this.a + this.turn * (Math.PI * 2) / 256 + Math.PI * 2) % (Math.PI * 2); }
  links() {
    const out = [];
    for (let i = 0; i < this.length; i++) out.push([this.ox + Math.cos(this.a) * i * 8, this.oy + Math.sin(this.a) * i * 8]);
    return out;
  }
  touches(box) {
    for (const [lx, ly] of this.links()) {
      if (lx + 3 > box.x && lx - 3 < box.x + box.w && ly + 3 > box.y && ly - 3 < box.y + box.h) return true;
    }
    return false;
  }
  hitBox() { return null; }
  gone() { return this.ox < this.game.camX - 96; }
  draw(ctx) {
    const g = this.game;
    const n = 1 + ((g.frame >> 2) & 3);
    for (const [lx, ly] of this.links()) g.assets.drawTL(ctx, 'items', 'fireball' + n, Math.round(lx - 4 - g.camX), Math.round(ly - 4), { variant: g.area.spriteVariant });
  }
}

// Bowser, King of the Koopas, on his bridge.  opts.fake: what he turns into
// when killed by fireballs (the false Bowsers of worlds 1-7); opts.hammers.
export class Bowser extends Enemy {
  constructor(game, x, y, opts = {}) {
    super(game, x, y, 32, 32);
    this.home = x;
    this.dir = -1;
    this.hp = 5;
    this.stompable = false;
    this.starImmune = true;
    this.fireT = 120;
    this.jumpT = 90;
    this.fake = opts.fake;
    this.hammers = !!opts.hammers;
    this.mouth = 0;
    this.moveT = 0;
    this.facing = -1;
  }
  hitBox() { return { x: this.x + 4, y: this.y + 4, w: 24, h: 28 }; }
  update() {
    const g = this.game;
    if (this.falling) {
      this.vy = Math.min(this.vy + 0.2, 3);
      this.y += this.vy;
      if (this.y > 260) this.dead = true;
      return;
    }
    const p = g.player;
    this.facing = p.cx < this.cx ? -1 : 1;
    // paces back and forth around where he stands
    if (++this.moveT % 128 === 0) this.dir = -this.dir;
    this.vx = this.moveT % 2 ? this.dir * 0.5 : 0;
    if (this.x < this.home - 48) this.dir = 1;
    if (this.x > this.home + 16) this.dir = -1;
    if (this.onGround && --this.jumpT <= 0) { this.vy = -2.5; this.jumpT = 120 + ((this.moveT * 37) % 60); }
    this.vy = Math.min(this.vy + 0.08, 3);
    moveBody(this, g.area);
    if (--this.fireT <= 0 && this.x < g.camX + 256) {
      this.mouth = 24;
      g.addEnt(new BowserFlame(g, this.x - 8, this.y + 8, p));
      g.sfx('bowser_fire');
      this.fireT = 140 + ((this.moveT * 53) % 90);
    }
    if (this.mouth > 0) this.mouth--;
  }
  fireHit() {
    const g = this.game;
    this.hp--;
    if (this.hp > 0) return false;
    this.dead = true;
    g.addScore(RULES.fireScore.bowser, this.cx, this.y);
    g.addEnt(new FlippedCorpse(g, this, 0));
    return true;
  }
  drop() { this.falling = true; this.vy = 0; this.game.sfx('bowser_fall'); }
  gone() { return this.y > 272; }
  corpseFrame() { return 'bowser_walk1'; }
  draw(ctx) {
    const step = (this.moveT >> 4) & 1 ? 2 : 1;
    const name = this.mouth > 0 ? `bowser_breath${step}` : `bowser_walk${step}`;
    this.sprite(ctx, 'enemies', name, { flip: this.facing > 0 });
  }
}

class BowserFlame extends Enemy {
  constructor(game, x, y, target) {
    super(game, x, y, 24, 8);
    this.targetY = Math.max(96, Math.min(192, Math.round((target.y + target.h - 16) / 16) * 16));
    this.stompable = false;
    this.fireImmune = true;
    this.starImmune = true;
  }
  hitBox() { return { x: this.x + 2, y: this.y + 1, w: 20, h: 6 }; }
  update() {
    this.x -= 1.5;
    if (this.y < this.targetY) this.y = Math.min(this.targetY, this.y + 0.5);
    if (this.y > this.targetY) this.y = Math.max(this.targetY, this.y - 0.5);
  }
  draw(ctx) { this.sprite(ctx, 'enemies', (this.game.frame >> 2) & 1 ? 'bowser_flame2' : 'bowser_flame1'); }
}

// ------------------------------------------------------------------ items

// Mushroom, 1-UP mushroom, fire flower and Starman coming out of a block.
export class PowerUp extends Ent {
  constructor(game, c, r, kind) {
    super(game, c * TILE, r * TILE, 16, 16);
    this.kind = kind; // mushroom | oneup | flower | star
    this.item = true;
    this.rise = 32; // half-pixels left to rise out of the block
    this.blockTop = r * TILE;
    this.dir = 1;
    game.sfx('powerup_appear');
  }
  update() {
    if (this.rise > 0) { this.rise--; this.y -= 0.5; return; }
    if (this.kind === 'flower') return;
    const area = this.game.area;
    this.vx = this.dir * 1;
    if (this.kind === 'star') {
      this.vy = Math.min(this.vy + 0.2, MAX_FALL);
      moveBody(this, area);
      if (this.onGround) this.vy = -4;
      if (this.hitHead) this.vy = 0;
    } else {
      this.vy = Math.min(this.vy + GRAVITY, MAX_FALL);
      moveBody(this, area);
    }
    if (this.hitWall) this.dir = -this.hitWall;
  }
  // Knocked up by a block bumped under it.
  hop(fromX) {
    if (this.rise > 0 || this.kind === 'flower') return;
    this.vy = -3;
    this.dir = fromX < this.cx ? 1 : -1;
  }
  draw(ctx) {
    const g = this.game;
    let name = this.kind;
    if (this.kind === 'flower') name = 'flower' + (1 + ((g.frame >> 1) & 3));
    if (this.kind === 'star') name = 'star' + (1 + ((g.frame >> 1) & 3));
    if (this.rise > 0) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(0, 0, 256, this.blockTop);
      ctx.clip();
      this.sprite(ctx, 'items', name);
      ctx.restore();
    } else this.sprite(ctx, 'items', name);
  }
}

// A coin knocked out of a block: spins up, falls back and scores.
export class BlockCoin extends Ent {
  constructor(game, c, r) {
    super(game, c * TILE, r * TILE - 16, 16, 16);
    this.vy = -5;
  }
  update() {
    this.t++;
    this.vy += 0.3;
    this.y += this.vy;
    if (this.vy > 2.5 && this.t > 10) {
      this.dead = true;
      this.game.addScore(RULES.coinScore, this.cx, this.y, true);
    }
  }
  draw(ctx) { this.sprite(ctx, 'items', 'coin_spin' + (1 + ((this.t >> 1) & 3))); }
}

export class Debris extends Ent {
  constructor(game, x, y, vx, vy) {
    super(game, x, y, 8, 8);
    this.vx = vx; this.vy = vy;
  }
  update() {
    this.t++;
    this.x += this.vx;
    this.vy = Math.min(this.vy + 0.3, 6);
    this.y += this.vy;
    if (this.y > 260) this.dead = true;
  }
  draw(ctx) {
    const g = this.game;
    g.assets.drawTL(ctx, 'items', 'brick_debris', Math.round(this.x - g.camX), Math.round(this.y), { variant: g.area.spriteVariant, flip: (this.t >> 2) & 1, flipV: (this.t >> 3) & 1 });
  }
}

export class ScorePopup extends Ent {
  constructor(game, x, y, text) {
    super(game, x - 8, y, 16, 8);
    this.text = text;
  }
  update() {
    this.t++;
    if (this.t < 32) this.y -= 1.5;
    if (this.t > 48) this.dead = true;
  }
  gone() { return false; }
  draw(ctx) {
    const g = this.game;
    g.assets.draw(ctx, 'items', 'score_' + this.text, Math.round(this.cx - g.camX), Math.round(this.y + 8), { variant: null });
  }
}

// Mario's fireball: bounces along the floor and bursts against walls.
export class Fireball extends Ent {
  constructor(game, x, y, dir) {
    super(game, x, y, 8, 8);
    this.vx = dir * 4;
    this.vy = 3;
    this.dir = dir;
    this.fireball = true;
    this.ledgeOpts = { ledge: 6, foot: 1 };
    game.sfx('fireball');
  }
  update() {
    this.t++;
    this.vx = this.dir * 4;
    this.vy = Math.min(this.vy + 0.45, 4);
    moveBody(this, this.game.area, this.ledgeOpts);
    if (this.onGround) this.vy = -3;
    if (this.hitWall || this.hitHead) this.burst();
    const g = this.game;
    if (this.x > g.camX + 256 || this.x + 8 < g.camX) this.dead = true;
  }
  burst() {
    this.dead = true;
    this.game.addEnt(new Burst(this.game, this.x - 4, this.y - 4));
    this.game.sfx('bump');
  }
  draw(ctx) {
    const g = this.game;
    g.assets.drawTL(ctx, 'items', 'fireball' + (1 + ((this.t >> 2) & 3)), Math.round(this.x - g.camX), Math.round(this.y), { variant: g.area.spriteVariant });
  }
}

class Burst extends Ent {
  constructor(game, x, y) { super(game, x, y, 16, 16); }
  update() { if (++this.t >= 12) this.dead = true; }
  draw(ctx) {
    const g = this.game;
    g.assets.drawTL(ctx, 'items', 'burst' + (1 + Math.min(2, this.t >> 2)), Math.round(this.x - g.camX), Math.round(this.y), { variant: g.area.spriteVariant });
  }
}

export class Firework extends Ent {
  constructor(game, x, y) { super(game, x, y, 16, 16); game.sfx('firework'); }
  update() { if (++this.t >= 24) this.dead = true; }
  gone() { return false; }
  draw(ctx) {
    const g = this.game;
    g.assets.drawTL(ctx, 'items', 'firework' + (1 + Math.min(2, this.t >> 3)), Math.round(this.x - g.camX), Math.round(this.y), { variant: null });
  }
}

// ----------------------------------------------------------- level objects

export class Flagpole extends Ent {
  constructor(game, x, top) {
    super(game, x, top, 16, 192 - top);
    this.pole = true;
    this.flagY = top + 16;
    this.flagDown = false;
  }
  gone() { return false; }
  get poleX() { return this.x + 8; }
  update() {
    if (this.flagDown && this.flagY < this.y + this.h - 16) this.flagY = Math.min(this.y + this.h - 16, this.flagY + 2);
  }
  draw(ctx) {
    const g = this.game;
    const sx = Math.round(this.x - g.camX);
    if (sx < -32 || sx > 256) return;
    g.assets.drawTL(ctx, 'tiles', 'flagpole_top', sx, this.y, { variant: g.area.tileVariant });
    for (let y = this.y + 16; y < this.y + this.h; y += 16) g.assets.drawTL(ctx, 'tiles', 'flagpole', sx, y, { variant: g.area.tileVariant });
    g.assets.drawTL(ctx, 'items', 'flag', sx - 8, Math.round(this.flagY), { variant: null });
  }
}

// Lifts: move 'v' (up and down between min and max), 'h' (side to side),
// 'fall' (drops while stood on), 'ride' (moves right once stood on),
// generators' lifts (opts.gen: keep rising / sinking and wrap round).
export class Lift extends Ent {
  constructor(game, x, y, opts = {}) {
    super(game, x, y, opts.w || 48, 8);
    this.platform = true;
    this.move = opts.move || null;
    this.min = opts.min; this.max = opts.max;
    this.dir = 1;
    this.gen = opts.gen || 0;
    this.speed = opts.speed || 1;
    this.dx = 0; this.dy = 0;
    this.rider = false;
    if (this.move === 'v' && this.min !== undefined) this.dir = -1;
  }
  gone() { return this.x + this.w < this.game.camX - 64; }
  update() {
    const ox = this.x, oy = this.y;
    if (this.gen) {
      this.y += this.gen;
      if (this.gen < 0 && this.y < -8) this.y = 248;
      if (this.gen > 0 && this.y > 248) this.y = -8;
    } else if (this.move === 'v') {
      this.y += this.dir * 0.75;
      if (this.y <= this.min) this.dir = 1;
      if (this.y >= this.max) this.dir = -1;
    } else if (this.move === 'h') {
      this.x += this.dir * 0.75;
      if (this.x <= this.min) this.dir = 1;
      if (this.x >= this.max) this.dir = -1;
    } else if (this.move === 'fall') {
      if (this.rider) this.y += 2;
    } else if (this.move === 'ride') {
      if (this.rider || this.started) { this.started = true; this.x += 1; }
    }
    this.dx = this.x - ox; this.dy = this.y - oy;
    this.rider = false;
  }
  draw(ctx) {
    const g = this.game;
    for (let i = 0; i < this.w; i += 8) g.assets.drawTL(ctx, 'items', g.area.sky === 'day' && g.area.theme === 'sky' ? 'lift_cloud' : 'lift', Math.round(this.x + i - g.camX), Math.round(this.y), { variant: g.area.spriteVariant });
  }
}

// The axe at the end of a castle; touching it drops the bridge and Bowser.
export class Axe extends Ent {
  constructor(game, x, y) { super(game, x, y, 16, 16); this.axe = true; }
  gone() { return false; }
  draw(ctx) {
    const g = this.game;
    const n = 1 + Math.floor((g.frame % 48) / 16);
    g.assets.drawTL(ctx, 'items', 'axe' + n, Math.round(this.x - g.camX), Math.round(this.y), { variant: g.area.spriteVariant });
  }
}

export class Chain extends Ent {
  constructor(game, x, y) { super(game, x, y, 16, 16); }
  gone() { return this.dead; }
  draw(ctx) {
    const g = this.game;
    g.assets.drawTL(ctx, 'items', 'chain', Math.round(this.x - g.camX), Math.round(this.y), { variant: g.area.spriteVariant });
  }
}

export class Npc extends Ent {
  constructor(game, x, y, kind, opts = {}) {
    super(game, x, y, 16, 24);
    this.kind = kind;
    this.opts = opts;
  }
  gone() { return false; }
  draw(ctx) { this.sprite(ctx, 'enemies', this.kind); }
}

// Builds the entity for a spawn record of the level data.
export function makeEnt(game, s) {
  const o = s.opts || {};
  switch (s.type) {
    case 'goomba': return new Goomba(game, s.x, s.y);
    case 'koopa': return new Koopa(game, s.x, s.y, o);
    case 'beetle': return new Koopa(game, s.x, s.y, { beetle: true });
    case 'piranha': return new Piranha(game, s.x, s.y, o);
    case 'podoboo': return new Podoboo(game, s.x, s.y);
    case 'firebar': return new Firebar(game, s.x, s.y, o);
    case 'bowser': return new Bowser(game, s.x, s.y, o);
    case 'flagpole': return new Flagpole(game, s.x, s.y);
    case 'lift': return new Lift(game, s.x, s.y, o);
    case 'axe': return new Axe(game, s.x, s.y);
    case 'chain': return new Chain(game, s.x, s.y);
    case 'toad': case 'princess': return new Npc(game, s.x, s.y, s.type, o);
    case 'liftgen': {
      // two lifts that keep rising (dir -1) or sinking (dir 1), half a screen apart
      const a = new Lift(game, s.x, 40, { w: o.w, gen: o.dir || 1 });
      const b = new Lift(game, s.x, 160, { w: o.w, gen: o.dir || 1 });
      return [a, b];
    }
    default: return null; // not in this build yet (P2 enemies)
  }
}
