<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Super Mario Bros. (web recreation)</title>
<link rel="icon" href="data:,">
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  body { display: flex; align-items: center; justify-content: center; }
  #screen { image-rendering: pixelated; image-rendering: crisp-edges; display: block; }
  #debug { position: fixed; left: 4px; top: 4px; margin: 0; padding: 4px 6px; max-width: 60vw; max-height: 96vh; overflow: auto;
           font: 11px/1.3 monospace; color: #0f0; background: rgba(0, 0, 0, 0.7); pointer-events: none; white-space: pre; }
  noscript { color: #fff; font: 16px sans-serif; }
</style>
</head>
<body>
<canvas id="screen" width="256" height="240" tabindex="0"></canvas>
<pre id="debug" hidden></pre>
<noscript>This game needs JavaScript.</noscript>
<script type="module" src="src/main.js"></script>
</body>
</html>
