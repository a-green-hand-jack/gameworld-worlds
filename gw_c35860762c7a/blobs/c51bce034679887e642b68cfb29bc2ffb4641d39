// Plays the artist's music and sound effects (manifest "audio") with Web
// Audio.  The AudioContext is created on the first key press or click, as
// browsers require; until then every call is a no-op.
export class Audio {
  constructor(assets) {
    this.assets = assets;
    this.entries = assets.manifest.audio || {};
    this.ctx = null;
    this.buffers = new Map(); // id -> AudioBuffer | null
    this.loading = new Map();
    this.sfxPlaying = new Map(); // id -> source
    this.musicId = null;
    this.musicSrc = null;
    this.musicGain = null;
    this.paused = false;
    this.muted = false;
  }

  unlock() {
    if (this.ctx) {
      if (this.ctx.state === 'suspended') this.ctx.resume();
      return;
    }
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    this.ctx = new AC();
    this.master = this.ctx.createGain();
    this.master.connect(this.ctx.destination);
    for (const id of Object.keys(this.entries)) this.fetch(id);
    if (this.pendingMusic) {
      const { id, opts } = this.pendingMusic;
      this.pendingMusic = null;
      this.music(id, opts);
    }
  }

  pickFile(entry) {
    const files = entry.files || (entry.file ? [entry.file] : []);
    const probe = document.createElement('audio');
    for (const f of files) {
      const ext = f.split('.').pop().toLowerCase();
      const type = { ogg: 'audio/ogg', mp3: 'audio/mpeg', wav: 'audio/wav', m4a: 'audio/mp4' }[ext];
      if (!type || probe.canPlayType(type)) return f;
    }
    return files[0];
  }

  fetch(id) {
    if (this.loading.has(id)) return this.loading.get(id);
    const entry = this.entries[id];
    if (!entry) return Promise.resolve(null);
    const file = this.pickFile(entry);
    const p = fetch('assets/' + file)
      .then((r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.arrayBuffer(); })
      .then((buf) => this.ctx.decodeAudioData(buf))
      .then((b) => { this.buffers.set(id, b); return b; })
      .catch((e) => { this.buffers.set(id, null); this.assets.reportMissing(`audio ${id} (${file}: ${e.message || e})`); return null; });
    this.loading.set(id, p);
    return p;
  }

  known(id) {
    if (this.entries[id]) return true;
    this.assets.reportMissing(`audio ${id}`);
    return false;
  }

  play(id) {
    if (!this.ctx || this.muted || !this.known(id)) return;
    const go = (buf) => {
      if (!buf) return;
      const prev = this.sfxPlaying.get(id);
      if (prev) try { prev.stop(); } catch (e) { /* already ended */ }
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      const g = this.ctx.createGain();
      g.gain.value = this.entries[id].volume ?? 1;
      src.connect(g).connect(this.master);
      src.onended = () => { if (this.sfxPlaying.get(id) === src) this.sfxPlaying.delete(id); };
      this.sfxPlaying.set(id, src);
      src.start();
    };
    const buf = this.buffers.get(id);
    if (buf !== undefined) go(buf); else this.fetch(id).then(go);
  }

  stopSfx(id) {
    const s = this.sfxPlaying.get(id);
    if (s) try { s.stop(); } catch (e) { /* ended */ }
    this.sfxPlaying.delete(id);
  }

  // Starts a music track or jingle; loops if the manifest says so.
  music(id, opts = {}) {
    if (this.musicId === id && this.musicSrc && !opts.restart) return;
    this.stopMusic();
    this.musicId = id;
    if (!id) return;
    if (!this.ctx) { this.pendingMusic = { id, opts }; return; }
    if (!this.known(id)) return;
    const token = (this.musicToken = (this.musicToken || 0) + 1);
    const go = (buf) => {
      if (!buf || token !== this.musicToken) return;
      const e = this.entries[id];
      const src = this.ctx.createBufferSource();
      src.buffer = buf;
      if (e.loop) {
        src.loop = true;
        if (e.loopStart !== undefined) src.loopStart = e.loopStart;
        src.loopEnd = e.loopEnd !== undefined ? e.loopEnd : buf.duration;
      }
      const g = this.ctx.createGain();
      g.gain.value = e.volume ?? 1;
      src.connect(g).connect(this.master);
      src.start();
      this.musicSrc = src;
      this.musicGain = g;
    };
    const buf = this.buffers.get(id);
    if (buf !== undefined) go(buf); else this.fetch(id).then(go);
  }

  stopMusic() {
    this.pendingMusic = null;
    this.musicToken = (this.musicToken || 0) + 1;
    if (this.musicSrc) try { this.musicSrc.stop(); } catch (e) { /* ended */ }
    this.musicSrc = null;
    this.musicId = null;
  }

  stopAll() {
    this.stopMusic();
    for (const id of [...this.sfxPlaying.keys()]) this.stopSfx(id);
  }

  setPaused(p) {
    if (!this.ctx || p === this.paused) return;
    this.paused = p;
    if (p) this.ctx.suspend(); else this.ctx.resume();
  }
}
