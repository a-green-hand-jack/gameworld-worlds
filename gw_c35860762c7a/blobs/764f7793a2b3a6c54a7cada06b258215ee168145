// Starts a site directory on a local static server, opens it in headless
// Chromium and drives it through window.smb.  Usage:
//   node tools/smoke.mjs <site-dir> <out-dir> [script]
// Scripts: title (default) | run11 (plays 1-1 with a simple bot)
// Needs the playwright package: PLAYWRIGHT=<path to playwright/index.js> if not installed here.
// BROWSER=firefox runs it in Playwright's Firefox instead of Chromium.
import http from 'node:http';
import fs from 'node:fs';
import path from 'node:path';

const pw = (await import(process.env.PLAYWRIGHT || 'playwright')).default;
const [site, out = '/tmp/smoke', script = 'title'] = process.argv.slice(2);
fs.mkdirSync(out, { recursive: true });

const TYPES = { '.html': 'text/html', '.js': 'text/javascript', '.mjs': 'text/javascript', '.json': 'application/json', '.png': 'image/png', '.ogg': 'audio/ogg', '.mp3': 'audio/mpeg', '.wav': 'audio/wav', '.md': 'text/plain' };
const server = http.createServer((req, res) => {
  const url = decodeURIComponent(req.url.split('?')[0]);
  const file = path.join(site, url === '/' ? 'index.html' : url);
  if (!file.startsWith(path.resolve(site)) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) { res.writeHead(404); res.end(); return; }
  res.writeHead(200, { 'content-type': TYPES[path.extname(file)] || 'application/octet-stream' });
  fs.createReadStream(file).pipe(res);
});
await new Promise((r) => server.listen(0, '127.0.0.1', r));
const base = `http://127.0.0.1:${server.address().port}/`;

const browser = process.env.BROWSER === 'firefox'
  ? await pw.firefox.launch()
  : await pw.chromium.launch({ args: ['--no-sandbox', '--autoplay-policy=no-user-gesture-required'] });
const page = await browser.newPage({ viewport: { width: 768, height: 720 } });
const log = [];
page.on('console', (m) => log.push(`[${m.type()}] ${m.text()}`));
page.on('pageerror', (e) => log.push(`[pageerror] ${e.message}`));
page.on('requestfailed', (r) => log.push(`[requestfailed] ${r.url()}`));

const shot = async (name) => {
  const data = await page.evaluate(() => document.getElementById('screen').toDataURL('image/png'));
  fs.writeFileSync(path.join(out, name + '.png'), Buffer.from(data.split(',')[1], 'base64'));
};
const st = () => page.evaluate(() => window.smb.state());
const step = (n) => page.evaluate((n) => window.smb.step(n), n);
const hold = (b) => page.evaluate((b) => window.smb.input.set(b), b);

const result = {};
try {
  await page.goto(base + (process.env.QUERY || ''));
  await page.waitForFunction(() => document.body.dataset.ready, null, { timeout: 15000 });
  result.ready = await page.evaluate(() => document.body.dataset.ready);
  await page.evaluate(() => window.smb.manual(true));
  await step(5);
  await shot('00-title');
  if (script === 'run11') await run11();
  else if (script !== 'title') await (await import(path.resolve(script))).default({ page, st, step, hold, shot, result });
} catch (e) {
  result.error = String(e.stack || e);
}
result.browser = `${process.env.BROWSER || 'chromium'} ${browser.version()}`;
result.final = await st().catch(() => null);
result.errors = log.filter((l) => /^\[(error|pageerror|requestfailed)\]/.test(l));
result.warnings = log.filter((l) => l.startsWith('[warning]'));
fs.writeFileSync(path.join(out, 'result.json'), JSON.stringify(result, null, 1));
fs.writeFileSync(path.join(out, 'console.log'), log.join('\n'));
console.log(JSON.stringify({ ready: result.ready, error: result.error, errors: result.errors, warnings: result.warnings.length, final: result.final && { state: result.final.state, level: result.final.level, seq: result.final.seq, x: result.final.player?.x, score: result.final.score, lives: result.final.lives }, trace: result.trace }, null, 1));
await browser.close();
server.close();

// A simple bot for 1-1: runs right, jumps over whatever is ahead.
async function run11() {
  await hold({ start: true }); await step(1); await hold({ start: false });
  await step(170);
  await shot('01-start');
  result.trace = [];
  let lastX = 0, stuck = 0, lastSeq = null;
  for (let i = 0; i < 3000; i++) {
    const s = await st();
    if (s.state !== 'play') {
      result.trace.push(`f${s.frame} ${s.state}`);
      if ((s.state === 'intermission' && s.level !== '1-1') || s.state === 'gameover' || s.state === 'title') break;
      await step(10); continue;
    }
    if (s.seq && s.seq !== 'introWalk') {
      if (s.seq !== lastSeq) { result.trace.push(`f${s.frame} seq ${s.seq} x${Math.round(s.player.x)} y${Math.round(s.player.y)} score ${s.score}`); await shot(`seq-${s.frame}-${s.seq}`); }
      lastSeq = s.seq;
      await hold({ right: false, a: false, b: false }); await step(4); continue;
    }
    lastSeq = null;
    const p = s.player;
    const danger = s.ents.some((e) => ['Goomba', 'Koopa'].includes(e.type) && e.x > p.x && e.x - p.x < 40 && Math.abs(e.y - p.y) < 40);
    const blocked = Math.abs(p.x - lastX) < 0.5;
    stuck = blocked ? stuck + 1 : 0;
    lastX = p.x;
    const jump = p.onGround && (danger || stuck > 2 || await page.evaluate((x) => {
      const g = window.smb.game; const a = g.area; const c = Math.floor((x + 30) / 16);
      return !a.solid(c, 13) || a.solid(c, 12) || a.solid(c, 11);
    }, p.x));
    await hold({ right: true, b: true, a: jump || (!p.onGround && p.vy < 0) });
    await step(2);
    if (i % 100 === 0) { result.trace.push(`f${s.frame} x${Math.round(p.x)} y${Math.round(p.y)} ${p.form}`); await shot(`run-${String(i).padStart(4, '0')}`); }
  }
}
