# transition frame between small and big (Mario "half grown"), 16x32
GROW = BIG_HEAD + """
....BBBRBBB.....
..BBBBBRRBBBBB..
.SSBBBRRRRBBBSS.
.SSSRRSRRSRRSSS.
.SS.RRRRRRRR.SS.
....RRRRRRRR....
...RRRRR.RRRRR..
...RRRR...RRRR..
...BBBB...BBBB..
..BBBBB...BBBBB.
"""

SMALL_ALL = dict(SMALL, swim4=SMALL["swim2"])


def stretch(grid, rows_at=(5, 13, 16, 19, 22)):
    """Big poses are drawn 26 rows tall; duplicate torso/leg rows to reach 31."""
    rows = parse(grid)
    if len(rows) != 26:
        return rows
    out = []
    for i, r in enumerate(rows):
        out.append(r)
        if i in rows_at:
            out.append(r)
    return out


def pad_top(grid, h):
    rows = parse(grid) if isinstance(grid, str) else grid
    if len(rows) > h:
        raise ValueError(f"grid {len(rows)} rows > {h}")
    return ["." * len(rows[0])] * (h - len(rows)) + rows


def sheets():
    """Names follow game-developer docs/assets.md: small_*, big_* (mario palette),
    fire_* (= every big_* pose in the fire palette, plus fire_throw),
    star1_* .. star3_* (copies of small_*/big_*/fire_throw in the flashing palettes)."""
    sh = Sheet("player")
    big = {k: stretch(v) for k, v in BIG.items() if k != "throw"}
    big["swim4"] = big["swim2"]
    throw = stretch(BIG["throw"])
    big["grow"] = GROW
    for pose, g in SMALL_ALL.items():
        sh.add(f"small_{pose}", pad_top(g, 16), "mario")
    for pose, g in big.items():
        sh.add(f"big_{pose}", pad_top(g, 32), "mario")
    for pose, g in big.items():
        sh.add(f"fire_{pose}", pad_top(g, 32), "fire")
    sh.add("fire_throw", pad_top(throw, 32), "fire")
    for n in (1, 2, 3):
        for pose, g in SMALL_ALL.items():
            sh.add(f"star{n}_small_{pose}", pad_top(g, 16), f"star{n}")
        for pose, g in big.items():
            sh.add(f"star{n}_big_{pose}", pad_top(g, 32), f"star{n}")
        sh.add(f"star{n}_fire_throw", pad_top(throw, 32), f"star{n}")
    return [(sh, None, "sprites/player.png")]
