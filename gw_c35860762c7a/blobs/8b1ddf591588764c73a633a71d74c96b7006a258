    "pipe": pipe,
    "oneup": oneup,
    "fireball": fireball,
    "flagpole": flagpole,
    "firework": firework,
    "bowser_fall": bowser_fall,
    "bowser_fire": bowser_fire,
    "vine": vine,
    "pause": pause,
    "beep": beep,
    "swim": swim,
    "cannon": cannon,
}
