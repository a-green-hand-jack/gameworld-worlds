# ============================================================================
# CASTLE - E minor / diminished, 160 BPM, 8 bars of neighbour-tone ostinato
# ============================================================================
CS_CH = ["Em", "F", "Em", "D#dim7", "Em", "C", "F#dim7", "B7"]
CS_P1 = Inst(duty=0.25, vol=9, release=4, gate=1.0)
CS_P2 = Inst(duty=0.5, vol=6, decay=3, sustain=3, release=3, gate=0.7, max_gate_gap=1)


def castle():
    bt = 16
    chart = chord_chart(CS_CH, bt)
    p1 = []
    for st, ln, pc, iv in chart:
        tones = sorted(m for m in range(68, 90) if (m - pc) % 12 in iv)
        order = [0, 1, 0, 2]
        for beat in range(4):
            x = tones[order[beat]]
            y = tones[order[beat] + 1]
            cell = [x, x - 1, x, y]
            if beat == 3 and st // bt == 7:
                cell = [x, y, tones[order[beat] + 2], y]  # lift into the loop
            for k, m in enumerate(cell):
                p1.append(Note(st + beat * 4 + k, 1, m))
    p2 = pattern_line(chart, [("R", 2), ("3", 2), ("5", 2), ("3", 2)], 57)
    bass = pattern_line(chart, [("R", 2), ("8", 2)], 40)
    return Track("castle", 160, bt, 8,
                 [Part("p1", p1, CS_P1), Part("p2", p2, CS_P2), Part("tri", bass, TRI)],
                 key="E minor (diminished)", meter="4/4")


