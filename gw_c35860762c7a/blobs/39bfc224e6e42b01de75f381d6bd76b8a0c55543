FANFARE = Inst(duty=0.5, vol=11, decay=8, sustain=8, release=1, gate=0.92,
               vib_depth=0.15, vib_rate=6.0, vib_delay=12)
FANFARE2 = Inst(duty=0.25, vol=7, decay=8, sustain=5, release=1, gate=0.92)


def _jingle(name, bpm, ticks, lead, harm_chart=None, p2=None, tri=None, drums=None,
            lead_inst=FANFARE, p2_inst=FANFARE2, tri_inst=TRI, key="", meter="4/4", drum_level=1.0):
    lead_n = parse_bars([lead], ticks)
    parts = [Part("p1", lead_n, lead_inst)]
    if harm_chart is not None:
        parts.append(Part("p2", harmonize(lead_n, harm_chart), p2_inst))
    elif p2 is not None:
        parts.append(Part("p2", parse_bars([p2], ticks), p2_inst))
    if tri is not None:
        parts.append(Part("tri", parse_bars([tri], ticks), tri_inst))
    dr = drum_line([drums], ticks) if drums else []
    return Track(name, bpm, ticks, 1, parts, drums=dr, drum_level=drum_level,
                 loop=False, key=key, meter=meter)


