def overworld():
    bt = 16
    lead_bars = OW_A + OW_A_END1 + OW_A + OW_A_END2 + OW_B + OW_A + OW_A_END2
    charts = OW_CH_A1 + OW_CH_A2 + OW_CH_B + OW_CH_A2
    lead = parse_bars(lead_bars, bt)
    chart = chord_chart(charts, bt)
    # harmony: parallel chord tones under the lead in the A sections,
    # calypso off-beat stabs in the B section
    harm = [n for n in harmonize(lead, chart) if not (16 * bt <= n.tick < 24 * bt)]
    stab_chart = [c for c in chart if 16 * bt <= c[0] < 24 * bt]
    stabs = pattern_line(stab_chart, [("r", 2), ("3", 2, "."), ("r", 2), ("5", 2, ".")], 62)
    bass = pattern_line(chart, [("R", 3), ("5", 3), ("8", 2), ("R", 3), ("5", 3), ("3", 2)], 40)
    groove = "K.hhS.h.K.hhS.h."
    fill = "K.hhS.h.SsS.SSSS"
    drums = drum_line(([groove] * 7 + [fill]) * 4, bt)
    return Track("overworld", 200, bt, 32,
                 [Part("p1", lead, OW_LEAD), Part("p2", harm + stabs, OW_HARM),
                  Part("tri", bass, TRI)],
                 drums=drums, drum_level=0.9, swing=0.6, key="G major", meter="4/4")


