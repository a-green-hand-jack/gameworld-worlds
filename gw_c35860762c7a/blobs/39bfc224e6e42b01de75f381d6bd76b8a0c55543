"""Original music for the project, written for a 2A03-style synth.

All melodies, harmonies and arrangements below are original compositions made
for this project.  They are written to fill the same *roles* as the music of
the 1985 game (bright overworld calypso, sparse underground riff, underwater
waltz, tense castle ostinato, frantic invincibility loop, jingles) but share
no melodic material with it.

Ticks are 16th notes.  Chord charts drive the bass, the harmony voice and the
accompaniment patterns (see sequencer.py).
"""
from __future__ import annotations

from sequencer import (Inst, Note, Part, Track, chord_chart, drum_line, harmonize,
                       parse_bars, pattern_line, parse_chord)
from nes_synth import note_to_midi


def chart_from(spans):
    """[('G7', 8), ('A7', 8)] -> chord chart with explicit lengths."""
    out = []
    t = 0
    for name, ticks in spans:
        pc, iv = parse_chord(name)
        out.append((t, ticks, pc, iv))
        t += ticks
    return out


