# ---- round-lump texture (coral block, seabed)
def lumps(centres, r, hi="L", mid="M", lo="K", size=16):
    out = []
    for y in range(size):
        row = ""
        for x in range(size):
            best = None
            for cx, cy in centres:
                for ox in (-size, 0, size):
                    for oy in (-size, 0, size):
                        dx, dy = x + 0.5 - (cx + ox), y + 0.5 - (cy + oy)
                        d = math.hypot(dx, dy)
                        if d <= r and (best is None or d < best[0]):
                            best = (d, dx, dy)
            if best is None:
                row += lo
            else:
                d, dx, dy = best
                if d > r - 1.2 and dx + dy > 0:
                    row += lo
                elif (dx + dy) < -r * 0.55:
                    row += hi
                else:
                    row += mid
        out.append(row)
    return out


def coral():
    return lumps([(4, 4), (12, 4), (0, 12), (8, 12)], 4.2)


def rounded_bevel(regions):
    """bevel() plus chunk corners knocked out to K (rounded stones)."""
    g = [list(r) for r in bevel(regions)]
    h, w = len(regions), len(regions[0])

    def diff(x, y, ox, oy):
        return not (0 <= ox < w and 0 <= oy < h) or regions[oy][ox] != regions[y][x]
    for y in range(h):
        for x in range(w):
            hz = diff(x, y, x - 1, y) or diff(x, y, x + 1, y)
            vt = diff(x, y, x, y - 1) or diff(x, y, x, y + 1)
            if hz and vt:
                g[y][x] = "K"
    return done(g)


