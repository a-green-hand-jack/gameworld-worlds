def canopy(h):
    """Oval tree crown 16 wide x h tall (palette tree)."""
    rx, ry = 7.5, h / 2.0
    cx, cy = 8.0, h / 2.0

    def inside(x, y):
        if x < 0 or x >= 16 or y < 0 or y >= h:
            return False
        return ((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 <= 1.0

    def base(x, y):
        nx, ny = (x + 0.5 - cx) / rx, (y + 0.5 - cy) / ry
        if nx * 0.8 + ny * 0.6 > 0.45:
            return "M"
        return "L"
    g = [list(r) for r in outline(inside, 16, h, base)]
    # a few leaf marks
    for i in range(3, h - 3, 6):
        for x, y in ((5, i), (4, i + 1), (10, i + 3), (9, i + 4)):
            if 0 <= y < h and g[y][x] == "L":
                g[y][x] = "M"
    return done(g)


TRUNK = ["......KBBK......"] * 16


def tree(total):
    crown = canopy(total - 16)
    return crown + TRUNK


# ---- castles
def castle_picture(W, H, tiers, windows, door):
    """tiers: list of (x0, x1, top) from back (highest) to front; each tier is
    a brick wall from `top+8` down to the next tier, crowned by merlons on
    rows top..top+7.  windows: (x, y, w, h). door: (x, y) of a 16x32 door."""
    def in_tier(x, y, x0, x1, top):
        if not (x0 <= x <= x1 and top <= y < H):
            return False
        return y >= top + 8 or MERLON[0] <= (x - x0) % 16 <= MERLON[1]

    layer = canvas(W, H)
    for y in range(H):
        for x in range(W):
            if any(in_tier(x, y, *t) for t in tiers):
                layer[y][x] = castle_brick(x, y)
    cv = [list(r) for r in outline_mask(done(layer), bottom_open=True)]
    for (wx, wy, ww, wh) in windows:
        for y in range(wy, wy + wh):
            for x in range(wx, wx + ww):
                corner = y == wy and (x == wx or x == wx + ww - 1)
                if not corner:
                    cv[y][x] = "K"
    dx, dy = door
    for y in range(dy, dy + 32):
        for x in range(dx, dx + 16):
            ex, ey = (x + 0.5 - (dx + 8)) / 8.0, (y + 0.5 - (dy + 8)) / 8.0
            if y >= dy + 8 or ex * ex + ey * ey <= 1.0:
                cv[y][x] = "K"
    return done(cv)


