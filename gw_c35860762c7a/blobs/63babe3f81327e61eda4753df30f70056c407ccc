def _outline_open(rows, left):
    """Outline except along the side that continues into the next tile."""
    h, w = len(rows), len(rows[0])

    def inside(x, y):
        if y < 0 or y >= h:
            return False
        if x < 0:
            return not left and rows[y][0] != "."
        if x >= w:
            return left and rows[y][w - 1] != "."
        return rows[y][x] != "."
    return outline(inside, w, h, lambda x, y: rows[y][x])


def cap_tiles(pattern):
    def keep_l(x, y):
        return x >= CAP_LEFT[y]

    def keep_r(x, y):
        return 15 - x >= CAP_LEFT[y]
    lt = _outline_open(mask_with(pattern, keep_l), left=True)
    rt = _outline_open(mask_with(pattern, keep_r), left=False)
    return lt, pattern, rt


