# ---- water / lava surfaces
def wave(phase, period=16, amp=1.5, base=4, layers=("L", "M"), fill="D"):
    out = []
    for y in range(16):
        r = ""
        for x in range(16):
            h = base + round(amp * math.sin(2 * math.pi * (x + phase) / period))
            if y < h:
                r += "."
            elif y - h < len(layers):
                r += layers[y - h]
            else:
                r += fill
        out.append(r)
    return out


def water_top(phase):
    g = wave(phase, base=3, layers=("L", "L", "M", "M"))
    g = [list(r) for r in g]
    for x, y in ((3 + phase, 10), (4 + phase, 10), (11 + phase, 13), (12 + phase, 13)):
        g[y][x % 16] = "M"
    return done(g)


