PIPE_RIM = ["K" * 32] + [PIPE_RIM_ROW] * 14 + ["K" * 32]
PIPE_BODY = [PIPE_BODY_ROW] * 16


def pipe_join():
    """Left half of a vertical pipe where a sideways pipe plugs in (16x32)."""
    hbody = transpose(PIPE_BODY)          # 16 wide x 32 tall
    collar = transpose(PIPE_RIM)          # 16 x 32 (mouth rim, sideways)
    vbody = vcat(PIPE_BODY, PIPE_BODY)    # 32 x 32
    out = []
    for y in range(32):
        r = hbody[y][0:2] + collar[y][0:1] + collar[y][1:4] + "K" + vbody[y][7:16]
        out.append(r)
    return out


