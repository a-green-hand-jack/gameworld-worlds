def hard_block(b=3):
    out = []
    for y in range(16):
        r = ""
        for x in range(16):
            tl, br = min(x, y), min(15 - x, 15 - y)
            if min(tl, br) >= b:
                r += "M"
            elif tl < br:
                r += "L"
            elif br < tl:
                r += "K"
            else:
                r += "M"
        out.append(r)
    return out


