# ================================================================ SCENERY
def cloud_runs(n_mid):
    """Column runs for a cloud 24 tall: left cap, n_mid middles, right cap."""
    lt = [13, 10, 8, 6, 5, 4, 3, 3, 2, 2, 2, 2, 3, 3, 4, 5]
    mt = [5, 3, 2, 1, 1, 0, 0, 0, 0, 0, 0, 1, 1, 2, 3, 5]
    lb = [18, 20, 21, 22, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 22]
    mb = [22, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 23, 22]
    ty = lt + mt * n_mid + lt[::-1]
    by = lb + mb * n_mid + lb[::-1]
    return ty, by


def puff_shade(ty, by, g, cusps, bottom_band=True):
    """Shading: bottom band + a short crease below each top cusp.
    cusps: x of the right column of each 2-column top valley."""
    w, h = len(g[0]), len(g)
    g = [list(r) for r in g]
    if bottom_band:
        for x in range(w):
            if ty[x] is None:
                continue
            for y in (by[x] - 2, by[x] - 1):
                if 0 <= y < h and g[y][x] == "L":
                    g[y][x] = "M"
    for c in cusps:
        v = ty[c]
        for x, y in ((c - 1, v + 1), (c, v + 1), (c, v + 2)):
            if g[y][x] == "L":
                g[y][x] = "M"
    return done(g)


def cloud(n_mid):
    ty, by = cloud_runs(n_mid)
    g = outline(runs(ty, by, 24), len(ty), 24, lambda x, y: "L")
    return puff_shade(ty, by, g, [16 * (i + 1) for i in range(n_mid + 1)])


def bush(n_mid):
    lt = [11, 8, 6, 5, 4, 3, 3, 2, 2, 2, 2, 2, 3, 3, 4, 5]
    mt = [5, 3, 2, 1, 1, 0, 0, 0, 0, 0, 0, 1, 1, 2, 3, 5]
    ty = lt + mt * n_mid + lt[::-1]
    by = [15] * len(ty)
    g = outline(runs(ty, by, 16, bottom_open=True), len(ty), 16, lambda x, y: "L")
    return puff_shade(ty, by, g, [16 * (i + 1) for i in range(n_mid + 1)], bottom_band=False)


