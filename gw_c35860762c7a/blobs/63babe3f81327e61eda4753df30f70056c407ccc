# ---------------------------------------------------------------- helpers
def G(s):
    return parse(s)


def hcat(*grids):
    return ["".join(r) for r in zip(*grids)]


def vcat(*grids):
    return [r for g in grids for r in g]


def crop(rows, x, y, w, h):
    return [r[x:x + w] for r in rows[y:y + h]]


def transpose(rows):
    return ["".join(c) for c in zip(*rows)]


def canvas(w, h, ch="."):
    return [[ch] * w for _ in range(h)]


def done(cv):
    return ["".join(r) for r in cv]


def drop_shadow(rows, ch, sh):
    """Pixels down-right of `ch` (and not `ch`) become `sh`."""
    out = [list(r) for r in rows]
    for y, r in enumerate(rows):
        for x, c in enumerate(r):
            if c == ch and y + 1 < len(rows) and x + 1 < len(r) and rows[y + 1][x + 1] != ch:
                out[y + 1][x + 1] = sh
    return done(out)


def bevel(regions, hi="L", mid="M", lo="K"):
    """Region map -> bevelled chunks: top/left edges `hi`, bottom/right `lo`.
    The tile border counts as a region boundary."""
    h, w = len(regions), len(regions[0])

    def same(x, y, ox, oy):
        if not (0 <= ox < w and 0 <= oy < h):
            return False
        return regions[oy][ox] == regions[y][x]
    out = []
    for y in range(h):
        r = ""
        for x in range(w):
            if regions[y][x] == ".":
                r += "."
            elif not same(x, y, x + 1, y) or not same(x, y, x, y + 1):
                r += lo
            elif not same(x, y, x - 1, y) or not same(x, y, x, y - 1):
                r += hi
            else:
                r += mid
        out.append(r)
    return out


def outline(inside, w, h, base, line="K", diag=False):
    """inside(x,y)->bool (may be called out of bounds).  Pixels inside with an
    outside neighbour become `line`, other inside pixels take base(x,y)."""
    nb = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    if diag:
        nb += [(1, 1), (-1, 1), (1, -1), (-1, -1)]
    out = []
    for y in range(h):
        r = ""
        for x in range(w):
            if not inside(x, y):
                r += "."
            elif any(not inside(x + dx, y + dy) for dx, dy in nb):
                r += line
            else:
                r += base(x, y)
        out.append(r)
    return out


def runs(ty, by, h, bottom_open=False):
    """Column runs [ty[x], by[x]] -> inside() function."""
    w = len(ty)

    def inside(x, y):
        if x < 0 or x >= w or y < 0:
            return False
        if y >= h:
            return bottom_open and ty[x] is not None
        return ty[x] is not None and ty[x] <= y <= by[x]
    return inside


def mask_with(rows, keep):
    """Keep pixels of rows where keep(x,y); others transparent."""
    return ["".join(c if keep(x, y) else "." for x, c in enumerate(r)) for y, r in enumerate(rows)]


def outline_mask(rows, line="K", diag=False, bottom_open=False, sides_open=False):
    """Outline the non-transparent area of rows with `line`."""
    h, w = len(rows), len(rows[0])

    def inside(x, y):
        if y >= h:
            return bottom_open and rows[h - 1][min(max(x, 0), w - 1)] != "."
        if x < 0 or x >= w:
            return sides_open and 0 <= y < h and rows[y][min(max(x, 0), w - 1)] != "."
        if y < 0:
            return False
        return rows[y][x] != "."
    return outline(inside, w, h, lambda x, y: rows[y][x], line, diag)


