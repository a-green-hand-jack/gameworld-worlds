def hill(W, H, spots, r=12.0):
    a = W / 2.0
    cy = a - r * math.sqrt(2)

    def f(x):
        xc = x + 0.5
        d = abs(xc - a)
        if d <= r / math.sqrt(2):
            return cy + math.sqrt(r * r - d * d)
        return min(xc, W - xc)

    tops = [H - round(f(x)) for x in range(W)]

    def inside(x, y):
        if x < 0 or x >= W or y < 0:
            return False
        if y >= H:
            return True
        return y >= tops[x]
    g = [list(r) for r in outline(inside, W, H, lambda x, y: "L", diag=True)]
    for sx, sy in spots:
        for yy, row in enumerate(SPOT):
            for xx, c in enumerate(row):
                if c != ".":
                    g[sy + yy][sx + xx] = c
    return done(g)


