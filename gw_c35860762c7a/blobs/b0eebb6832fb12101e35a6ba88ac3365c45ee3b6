# 3x5 digits for score popups
DIGITS = {
    "0": ["WWW", "W.W", "W.W", "W.W", "WWW"],
    "1": [".W.", "WW.", ".W.", ".W.", "WWW"],
    "2": ["WWW", "..W", "WWW", "W..", "WWW"],
    "4": ["W.W", "W.W", "WWW", "..W", "..W"],
    "5": ["WWW", "W..", "WWW", "..W", "WWW"],
    "8": ["WWW", "W.W", "WWW", "W.W", "WWW"],
    "U": ["W.W", "W.W", "W.W", "W.W", "WWW"],
    "P": ["WWW", "W.W", "WWW", "W..", "W.."],
}


def score_grid(text, w=16, h=8):
    cols = [""] * 5
    for i, ch in enumerate(text):
        for r in range(5):
            cols[r] += ("." if i else "") + DIGITS[ch][r]
    tw = len(cols[0])
    left = (w - tw) // 2
    rows = ["." * w] * 1 + ["." * left + c + "." * (w - left - tw) for c in cols]
    return rows + ["." * w] * (h - len(rows))


def rot90(rows):
    n = len(rows)
    return ["".join(rows[n - 1 - c][r] for c in range(n)) for r in range(len(rows[0]))]


