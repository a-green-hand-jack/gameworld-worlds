def sheets():
    """Names follow game-developer docs/assets.md (items table)."""
    sh = Sheet("items")
    sh.add("mushroom", MUSHROOM, "mushroom")
    sh.add("oneup", MUSHROOM, "oneup")
    for i in range(4):
        sh.add(f"flower{i+1}", FLOWER, f"flower{i+1}")
    for i in range(4):
        sh.add(f"star{i+1}", STAR, f"star_i{i+1}")
    for i, pal in enumerate(["coin", "coin2", "coin3"]):
        sh.add(f"coin{i+1}", COIN_FACE, pal)
    sh.add("coin_spin1", COIN_FACE, "coin")
    sh.add("coin_spin2", COIN_HALF, "coin")
    sh.add("coin_spin3", COIN_EDGE, "coin")
    sh.add("coin_spin4", hflip(parse(COIN_HALF)), "coin")
    for i, g in enumerate(POP):
        sh.add(f"burst{i+1}", g, "fireball")
    sh.add("flag", FLAG, "flag")
    sh.add("castle_flag", CFLAG, "cflag")
    sh.add("vine_top", VINE_TOP, "vine")
    sh.add("vine", VINE, "vine")
    for i, g in enumerate(FIREWORK):
        sh.add(f"firework{i+1}", g, "firework")
    sh.add("axe1", AXE, "axe")
    sh.add("axe2", AXE, "axe2")
    sh.add("axe3", AXE, "axe3")
    sh.add("bowser_bridge", BRIDGE, "cbridge")
    sh.add("chain", CHAIN, "chain")
    for i, g in enumerate(SPRING):
        rows = parse(g)
        rows = ["." * 16] * (32 - len(rows)) + rows
        sh.add(f"spring{i+1}", rows, "spring")
    for t in ["100", "200", "400", "500", "800", "1000", "2000", "4000", "5000", "8000", "1UP"]:
        sh.add(f"score_{t.lower()}", score_grid(t), "score")
    fb = parse(FIREBALL)
    for i in range(4):
        sh.add(f"fireball{i+1}", fb, "fireball")
        fb = rot90(fb)
    sh.add("brick_debris", DEBRIS, "debris")
    sh.add("lift", LIFT, "lift")
    sh.add("lift_cloud", LIFT_CLOUD, "cloud")
    sh.add("hud_coin1", HUD_COIN, "coin")
    sh.add("hud_coin2", HUD_COIN, "coin2")
    sh.add("hud_coin3", HUD_COIN, "coin3")
    sh.add("mushroom_cursor", CURSOR, "mushroom")
    return [(sh, ["overworld", "underground", "castle", "underwater"], "sprites/items_{theme}.png")]


