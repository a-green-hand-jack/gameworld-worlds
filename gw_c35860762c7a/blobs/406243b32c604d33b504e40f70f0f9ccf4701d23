def glyphs():
    out = {}
    for line in G.strip("\n").split("\n"):
        ch, *rows = line.split(" ")
        out[ch] = [r + "." for r in rows] + ["." * 8]
    out["©"] = parse(COPY)
    return out


def logo():
    """Title board: 'SUPER' at 2x, 'MARIO BROS.' at 2x wide / 3x tall, on a bevelled board."""
    gl = glyphs()
    W, H = 192, 60
    px = [["M"] * W for _ in range(H)]
    for x in range(W):
        for y in range(H):
            if x in (0, W - 1) or y in (0, H - 1):
                px[y][x] = "K"
            elif x == 1 or y == 1:
                px[y][x] = "L"
            elif x == W - 2 or y == H - 2:
                px[y][x] = "K"
    # rivets
    for (rx, ry) in [(4, 4), (W - 7, 4), (4, H - 7), (W - 7, H - 7)]:
        for dx in range(3):
            for dy in range(3):
                px[ry + dy][rx + dx] = "L" if dx + dy < 2 else "K"

    def text(s, x0, y0, sx, sy):
        x = x0
        for ch in s:
            g = gl[ch]
            for gy, row in enumerate(g):
                for gx, c in enumerate(row):
                    if c == "W":
                        for a in range(sx):
                            for b in range(sy):
                                X, Y = x + gx * sx + a, y0 + gy * sy + b
                                px[Y + 1][X + 1] = "K" if px[Y + 1][X + 1] != "L" else "L"
                                px[Y][X] = "L"
            x += 8 * sx
    text("SUPER", 10, 6, 2, 2)
    text("MARIO", 10, 26, 2, 3)
    text("BROS.", 98, 26, 2, 3)
    return ["".join(r) for r in px]


FONT_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-x!.,'?©:/"


def sheets():
    return []


def extras(assets):
    """Font grid (cell 8x8, 16 columns) and the title board, as the loader expects."""
    import os
    from lib import render
    from palettes import PALETTES
    gl = glyphs()
    cols = 16
    rows = (len(FONT_CHARS) + cols - 1) // cols
    from PIL import Image
    im = Image.new("RGBA", (cols * 8, rows * 8), (0, 0, 0, 0))
    for i, ch in enumerate(FONT_CHARS):
        im.alpha_composite(render(gl[ch], PALETTES["score"]), ((i % cols) * 8, (i // cols) * 8))
    os.makedirs(os.path.join(assets, "ui"), exist_ok=True)
    im.save(os.path.join(assets, "ui", "font.png"), optimize=True)
    render(logo(), PALETTES["ground"]).save(os.path.join(assets, "ui", "title.png"), optimize=True)
    return {"font": {"file": "ui/font.png", "cell": [8, 8], "columns": cols, "chars": FONT_CHARS},
            "title": {"file": "ui/title.png"}}
