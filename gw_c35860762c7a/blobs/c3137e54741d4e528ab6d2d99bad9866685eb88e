"""Tiny tracker/sequencer on top of nes_synth.

Music is written as text, one string per bar, tokens ``<note>:<ticks>[flags]``
where a tick is a 16th note, e.g. ``"D5:3 G5:3 A5:2 B5:2 A5:2 G5:2 D5:2"``.
``r`` is a rest.  Flags: ``.`` staccato, ``_`` legato (full length),
``>`` accent.  Every bar is checked to add up to the bar length.

Helpers generate the accompaniment from a chord chart so that harmony,
bass and lead always agree:
  * :func:`harmonize` - second voice a chord tone (3..9 semitones) below the lead
  * :func:`pattern_line` - bass / stab / arpeggio lines from degree patterns
  * drum patterns: one character per 16th (K kick, S snare, h hat, o open hat,
    C crash, s soft snare, '.' nothing)
"""
from __future__ import annotations

import math
from dataclasses import dataclass, field, replace

import numpy as np

from nes_synth import (SR, APU, Event, midi_to_hz, note_to_midi, noise_rate)

FPS = 60.0


# ----------------------------------------------------------------------------
# instruments
# ----------------------------------------------------------------------------
@dataclass
class Inst:
    duty: float | list = 0.5        # pulse duty, or per-frame list (last value holds)
    vol: int = 10                   # peak volume 0..15
    decay: float = 0.0              # frames per volume step while held (0 = flat)
    sustain: int = 0                # floor for the decay
    release: float = 3.0            # volume steps lost per frame after the gate
    gate: float = 0.9               # fraction of the written length that is held
    max_gate_gap: float = 0.12      # seconds: the gap is never longer than this
    vib_depth: float = 0.0          # semitones (peak)
    vib_rate: float = 5.5           # Hz
    vib_delay: int = 12             # frames before vibrato starts
    scoop: float = 0.0              # start this many semitones flat ...
    scoop_frames: int = 0           # ... and glide up over this many frames
    attack: list = field(default_factory=list)  # explicit first-frame volumes
    transpose: int = 0


def note_frames(inst: Inst, midi: float, dur_s: float, accent=0, gate=None, tri=False):
    """Per-frame (freq, vol, duty) tables for one note."""
    if gate is None:
        held = dur_s * inst.gate
        held = max(held, dur_s - inst.max_gate_gap) if inst.gate < 1.0 else dur_s
    else:
        held = dur_s * gate
    n_gate = max(1, int(round(held * FPS)))
    if tri:
        n_rel = 0
    else:
        n_rel = int(math.ceil(inst.vol / inst.release)) if inst.release > 0 else 0
    n = n_gate + n_rel
    f = np.arange(n)
    peak = min(15, inst.vol + accent)
    if inst.decay > 0:
        v = np.maximum(inst.sustain, peak - np.floor(f / inst.decay))
    else:
        v = np.full(n, float(peak))
    for i, a in enumerate(inst.attack):
        if i < n:
            v[i] = min(15, a + accent)
    if n_rel:
        vg = v[n_gate - 1]
        rel = vg - inst.release * (f[n_gate:] - n_gate + 1)
        v[n_gate:] = np.maximum(0.0, rel)
    v = np.floor(v)
    m = np.full(n, float(midi + inst.transpose))
    if inst.vib_depth > 0:
        t = np.maximum(0, f - inst.vib_delay) / FPS
        depth = np.where(f >= inst.vib_delay, inst.vib_depth, 0.0)
        m = m + depth * np.sin(2 * np.pi * inst.vib_rate * t)
    if inst.scoop and inst.scoop_frames:
        k = np.clip(f / inst.scoop_frames, 0, 1)
        m = m - inst.scoop * (1 - k)
    freq = midi_to_hz(m)
    if tri:
        v = np.where(f < n_gate, 1.0, 0.0)
    if isinstance(inst.duty, (list, tuple)):
        d = np.array([inst.duty[min(i, len(inst.duty) - 1)] for i in range(n)], dtype=float)
    else:
        d = np.full(n, float(inst.duty))
    return freq, v, d


# noise drum kit: list of (period_index, volume, short_mode) per frame
DRUMS = {
    "K": [(9, 13, 0), (11, 10, 0), (12, 7, 0), (13, 4, 0), (13, 2, 0)],
    "S": [(5, 12, 0), (6, 10, 0), (6, 8, 0), (7, 6, 0), (7, 5, 0), (7, 3, 0), (8, 2, 0), (8, 1, 0)],
    "s": [(5, 7, 0), (6, 5, 0), (7, 3, 0), (7, 2, 0), (8, 1, 0)],
    "h": [(0, 6, 0), (0, 3, 0), (0, 1, 0)],
    "o": [(1, 6, 0), (1, 5, 0), (1, 4, 0), (1, 3, 0), (1, 3, 0), (1, 2, 0), (1, 1, 0), (1, 1, 0)],
    "C": [(3, 12, 0)] + [(3 + (i > 6) + (i > 16), max(1, 11 - i // 3), 0) for i in range(36)],
    "t": [(2, 8, 1), (2, 5, 1), (2, 2, 1)],   # metallic tick (short mode)
}


def drum_event(ch_start: int, name: str, level=1.0, seed=0):
    frames = DRUMS[name]
    idx = np.array([p for p, _, _ in frames])
    vol = np.array([max(0.0, min(15.0, round(v * level))) for _, v, _ in frames])
    mode = np.array([float(m) for _, _, m in frames])
    return Event("noise", ch_start, noise_rate(idx), vol, mode, phase0=float((seed * 7919) % 32749))


# ----------------------------------------------------------------------------
# notation
# ----------------------------------------------------------------------------
@dataclass
class Note:
    tick: int
    ticks: int
    midi: int | None
    flags: str = ""


def parse_bars(bars: list[str], bar_ticks: int, start_tick: int = 0) -> list[Note]:
    out = []
    t = start_tick
    for bi, bar in enumerate(bars):
        total = 0
        for tok in bar.split():
            name, rest = tok.split(":")
            j = 0
            while j < len(rest) and rest[j].isdigit():
                j += 1
            ticks = int(rest[:j])
            flags = rest[j:]
            midi = None if name == "r" else note_to_midi(name)
            out.append(Note(t + total, ticks, midi, flags))
            total += ticks
        if total != bar_ticks:
            raise ValueError(f"bar {bi} '{bar}' has {total} ticks, expected {bar_ticks}")
        t += bar_ticks
    return [n for n in out if n.midi is not None]


CHORD_Q = {"": [0, 4, 7], "m": [0, 3, 7], "7": [0, 4, 7, 10], "m7": [0, 3, 7, 10],
           "maj7": [0, 4, 7, 11], "dim": [0, 3, 6], "dim7": [0, 3, 6, 9], "aug": [0, 4, 8],
           "sus4": [0, 5, 7], "m6": [0, 3, 7, 9], "6": [0, 4, 7, 9]}


def parse_chord(name: str):
    root = name[0]
    i = 1
    acc = 0
    while i < len(name) and name[i] in "#b":
        acc += 1 if name[i] == "#" else -1
        i += 1
    q = name[i:]
    pc = (note_to_midi(root + "4") + acc) % 12
    return pc, CHORD_Q[q]


def chord_chart(bars: list[str], bar_ticks: int):
    """['G', 'C D7', ...] -> list of (start_tick, ticks, root_pc, intervals)."""
    out = []
    for bi, bar in enumerate(bars):
        names = bar.split()
        span = bar_ticks // len(names)
        for k, nm in enumerate(names):
            pc, iv = parse_chord(nm)
            out.append((bi * bar_ticks + k * span, span, pc, iv))
    return out


def chord_at(chart, tick):
    for st, ln, pc, iv in chart:
        if st <= tick < st + ln:
            return pc, iv
    return chart[-1][2], chart[-1][3]


def harmonize(lead: list[Note], chart, lo=3, hi=9, floor_midi=55):
    """Second voice: highest chord tone between lo..hi semitones below the lead."""
    out = []
    for n in lead:
        pc, iv = chord_at(chart, n.tick)
        tones = {(pc + i) % 12 for i in iv}
        cand = [m for m in range(n.midi - hi, n.midi - lo + 1) if m % 12 in tones and m >= floor_midi]
        if not cand:
            cand = [m for m in range(n.midi - 12, n.midi - 2) if m % 12 in tones]
        if cand:
            out.append(Note(n.tick, n.ticks, max(cand), n.flags))
    return out


DEG = {"R": 0, "8": 12, "5": 7, "5-": -5, "3": None, "7": None, "9": 14, "6": 9, "15": 19, "3+": None}


def pattern_line(chart, pattern, lo_midi, flags_default=""):
    """Repeat a degree pattern over every chord of the chart.

    pattern: list of (degree, ticks[, flags]); degree in R,3,5,7,8,5-,3+,9,6 or 'r'.
    The chord root is placed in [lo_midi, lo_midi+11]."""
    out = []
    for st, ln, pc, iv in chart:
        root = lo_midi + ((pc - lo_midi) % 12)
        t = st
        k = 0
        while t < st + ln:
            item = pattern[k % len(pattern)]
            deg, ticks = item[0], item[1]
            fl = item[2] if len(item) > 2 else flags_default
            ticks = min(ticks, st + ln - t)
            if deg != "r":
                if deg == "3":
                    m = root + iv[1]
                elif deg == "3+":
                    m = root + iv[1] + 12
                elif deg == "7":
                    m = root + (iv[3] if len(iv) > 3 else 12)
                elif deg == "5" and len(iv) > 2:
                    m = root + iv[2]
                elif deg == "5+":
                    m = root + iv[2] + 12
                else:
                    m = root + DEG[deg]
                out.append(Note(t, ticks, m, fl))
            t += ticks
            k += 1
    return out


def drum_line(bars: list[str], bar_ticks: int):
    out = []
    for bi, bar in enumerate(bars):
        bar = bar.replace(" ", "")
        if len(bar) != bar_ticks:
            raise ValueError(f"drum bar {bi} '{bar}' is {len(bar)} ticks")
        for k, c in enumerate(bar):
            if c != ".":
                out.append((bi * bar_ticks + k, c))
    return out


# ----------------------------------------------------------------------------
# tracks
# ----------------------------------------------------------------------------
@dataclass
class Part:
    ch: str
    notes: list
    inst: Inst
    level: float = 1.0      # drums only


@dataclass
class Track:
    name: str
    bpm: float
    bar_ticks: int          # 16 for 4/4, 12 for 3/4
    bars: int
    parts: list
    drums: list = field(default_factory=list)
    drum_level: float = 1.0
    swing: float = 0.5      # fraction of a beat taken by the first 8th
    loop: bool = True
    key: str = ""
    meter: str = "4/4"

    def ticks(self):
        return self.bars * self.bar_ticks


def tick_time(tick, bpm, swing):
    spb = 60.0 / bpm
    b = math.floor(tick / 4)
    q = tick - 4 * b
    if q <= 2:
        t = q / 2 * swing
    else:
        t = swing + (q - 2) / 2 * (1 - swing)
    return (b + t) * spb


def _events_for(track: Track, bpm: float, offset: int):
    evs = []
    for part in track.parts:
        tri = part.ch == "tri"
        for n in part.notes:
            t0 = tick_time(n.tick, bpm, track.swing)
            t1 = tick_time(n.tick + n.ticks, bpm, track.swing)
            gate = None
            if "." in n.flags:
                gate = 0.45
            if "_" in n.flags:
                gate = 1.0
            accent = 2 if ">" in n.flags else 0
            f, v, d = note_frames(part.inst, n.midi, t1 - t0, accent=accent, gate=gate, tri=tri)
            evs.append(Event(part.ch, offset + int(round(t0 * SR)), f, v, d))
    for tick, name in track.drums:
        t0 = tick_time(tick, bpm, track.swing)
        evs.append(drum_event(offset + int(round(t0 * SR)), name, track.drum_level, seed=tick + 1))
    return evs


def render_track(track: Track, tempo_scale=1.0, tail_s=2.5):
    """Render a track.

    Loops are rendered three times back to back; the middle iteration is
    returned, so release tails of the previous pass are already wrapped
    around into the start and the end flows seamlessly into the start.
    Returns (audio, info) where info has loop_samples and a seam check."""
    bpm = track.bpm * tempo_scale
    length_s = track.ticks() / 4 * 60.0 / bpm
    L = int(round(length_s * SR))
    if track.loop:
        n = 3 * L + int(tail_s * SR)
        apu = APU(n)
        for k in range(3):
            apu.extend(_events_for(track, bpm, k * L))
        y = apu.render()
        loop = y[L:2 * L].copy()
        nxt = y[2 * L:2 * L + 2048]
        seam_err = float(np.max(np.abs(nxt - y[L:L + 2048])))
        return loop, {"loop_samples": L, "seam_err": seam_err, "bpm": bpm}
    n = L + int(tail_s * SR)
    apu = APU(n)
    apu.extend(_events_for(track, bpm, 0))
    y = apu.render()
    return y, {"bpm": bpm, "body_samples": L}


def trim_tail(y, thresh=2e-4, fade_ms=8.0, min_len=0):
    nz = np.flatnonzero(np.abs(y) > thresh)
    end = (nz[-1] + 1) if len(nz) else 1
    end = max(end, min_len)
    fade = int(SR * fade_ms / 1000)
    end = min(len(y), end + fade)
    y = y[:end].copy()
    k = min(fade, len(y))
    y[-k:] *= np.linspace(1.0, 0.0, k) ** 2
    return y
