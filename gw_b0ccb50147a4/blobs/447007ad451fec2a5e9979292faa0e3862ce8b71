"""Headless-browser play-through of an unzipped build over file://.
Usage: python3 tools/qa.py <dir containing index.html> <screenshot dir>"""
import sys, os, time
from playwright.sync_api import sync_playwright
root, out = os.path.abspath(sys.argv[1]), sys.argv[2]
os.makedirs(out, exist_ok=True)
errs = []
with sync_playwright() as p:
    b = p.chromium.launch()
    pg = b.new_page(viewport={"width": 900, "height": 700})
    pg.on("pageerror", lambda e: errs.append(str(e)))
    pg.on("console", lambda m: errs.append(m.text) if m.type == "error" else None)
    pg.goto("file://" + root + "/index.html")
    pg.wait_for_timeout(500)
    assert pg.evaluate("document.getElementById('game').getContext('2d') !== null")
    pg.screenshot(path=out + "/01-title.png")
    pg.keyboard.press("Space")
    pg.wait_for_timeout(200)
    assert pg.evaluate("__game.state") == "playing"
    # steer with real arrow key events toward the nearest star
    t0 = time.time(); shot = False
    while pg.evaluate("__game.state") == "playing":
        s = pg.evaluate("(()=>{const g=__game;let b=null,d=1e9;for(const s of g.stars){const q=(s.x-g.ball.x)**2+(s.y-g.ball.y)**2;if(q<d){d=q;b=s}}return b&&[b.x-g.ball.x,b.y-g.ball.y]})()")
        for k in ("ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"): pg.keyboard.up(k)
        if s:
            if s[0] > 8: pg.keyboard.down("ArrowRight")
            if s[0] < -8: pg.keyboard.down("ArrowLeft")
            if s[1] > 8: pg.keyboard.down("ArrowDown")
            if s[1] < -8: pg.keyboard.down("ArrowUp")
        if not shot and pg.evaluate("__game.timeLeft") < 22 and pg.evaluate("__game.score") > 0:
            pg.screenshot(path=out + "/02-playing.png"); shot = True
        pg.wait_for_timeout(30)
        assert time.time() - t0 < 40, "game did not end"
    score = pg.evaluate("__game.score")
    pg.wait_for_timeout(200)
    pg.screenshot(path=out + "/03-gameover.png")
    best = pg.evaluate("localStorage.getItem('starCatcher.best')")
    print("elapsed %.1fs score %s best-stored %s" % (time.time() - t0, score, best))
    assert int(best) == score and score > 0
    pg.reload(); pg.wait_for_timeout(400)
    assert pg.inner_text("#best") == str(score), "best not persisted"
    pg.keyboard.press("Enter"); pg.wait_for_timeout(300)
    assert pg.evaluate("__game.state") == "playing" and pg.evaluate("__game.score") == 0
    pg.screenshot(path=out + "/04-restart-best-kept.png")
    print("console errors:", errs)
    b.close()
print("QA OK")
