# main
# ----------------------------------------------------------------------------
def verify_row(path, ref, kind):
    """Decode an encoded file and measure it.  Returns (cells, problems, decoded)."""
    y = decode(path)
    pk, rms = peak_rms(y)
    above = np.nonzero(np.abs(y) > 10 ** (-50 / 20))[0]
    lead_ms = 1000 * above[0] / SR if len(above) else float("inf")
    probs = []
    if not np.all(np.isfinite(y)):
        probs.append("NaN")
    if pk >= 1.0:
        probs.append("CLIP")
    # music .ogg must be sample-exact (seamless <audio loop>).  One-shots may differ
    # by up to one Vorbis block: ffmpeg's demuxer trims 128 samples of a
    # single-page stream, while libvorbisfile decodes them exactly.
    if path.endswith(".ogg"):
        tol = 0 if kind == "music" else 1100
        if abs(len(y) - len(ref)) > tol:
            probs.append(f"LEN({len(y) - len(ref):+d})")
    if kind != "music" and lead_ms > 5:
        probs.append("LEAD")
    seam = ""
    if kind == "music":
        # seam check: jump from last to first sample vs. typical sample-to-sample step
        d = np.abs(np.diff(y))
        seam = f"{abs(y[0] - y[-1]) / (np.percentile(d, 99.9) + 1e-12):.2f}"
        if path.endswith(".ogg") and float(seam) > 1.0:
            probs.append("SEAM")
    cells = (len(y) / SR, len(ref) / SR, db(pk), db(rms), lead_ms, seam)
    return cells, probs, y


def main():
    if not FFMPEG:
        sys.exit("ffmpeg not found (set FFMPEG=/path/to/ffmpeg)")
    out_dir = os.path.join(ASSETS, "audio")
    for d in (out_dir, CHECK_DIR):
        os.makedirs(d, exist_ok=True)
    known = set(SFX) | set(JINGLES) | set(MUSIC)
    for f in os.listdir(out_dir):                  # drop stale renders of renamed sounds
        if f.rsplit(".", 1)[0] not in known and f.endswith((".ogg", ".mp3")):
            os.remove(os.path.join(out_dir, f))

    manifest = {"format_note": "", "sfx": {}, "jingles": {}, "music": {}}
    rendered = {}                                  # name -> (reference audio, kind)

    # ---- sound effects and jingles (peak-normalised one-shots) ------------------
    for group, table in (("sfx", SFX), ("jingles", JINGLES)):
        for name, (build, event) in table.items():
            y = render_oneshot(build)
            y *= 10 ** (SFX_PEAK_DB / 20) / peak_rms(y)[0]
            y = encode_checked(y, os.path.join(out_dir, name))
            manifest[group][name] = {"files": [f"audio/{name}.ogg", f"audio/{name}.mp3"],
                                     "event": event, "duration": round(len(y) / SR, 4)}
            rendered[name] = (y, group)
            print(f"rendered {group:7s} {name:18s} {len(y) / SR:6.3f} s")

    # ---- music loops (RMS-normalised, peak-limited by gain only) ----------------
    for name, (factory, bpm, event) in MUSIC.items():
        song = factory(bpm)
        y = render_loop(song)
        pk, rms = peak_rms(y)
        y *= min(10 ** (MUSIC_PEAK_DB / 20) / pk, 10 ** (MUSIC_RMS_DB / 20) / rms)
        y = encode_checked(y, os.path.join(out_dir, name))
        manifest["music"][name] = {"files": [f"audio/{name}.ogg", f"audio/{name}.mp3"], "event": event,
                                   "loopStart": 0.0, "loopEnd": round(len(y) / SR, 6),
                                   "loopEndSamples": len(y), "bpm": bpm, "bars": int(song.total // 8)}
        rendered[name] = (y, "music")
        print(f"rendered music   {name:18s} {len(y) / SR:7.3f} s  ({song.total // 8} bars @ {bpm} bpm)")

    # ---- verification -------------------------------------------------------------
    print()
    hdr = (f"{'file':26s} {'kind':7s} {'dur s':>7s} {'expect':>7s} {'peak dBFS':>9s} {'RMS dBFS':>8s} "
           f"{'lead ms':>7s} {'seam':>5s} {'kB':>6s}  status")
    print(hdr)
    print("-" * len(hdr))
    total_bytes, problems, mp3_offsets = 0, [], []
    sheets = {"sfx": [], "jingles": [], "music": []}
    for name, (ref, kind) in rendered.items():
        for ext in ("ogg", "mp3"):
            path = os.path.join(out_dir, f"{name}.{ext}")
            size = os.path.getsize(path)
            total_bytes += size
            (dur, exp, pk_db, rms_db, lead_ms, seam), probs, y = verify_row(path, ref, kind)
            st = "ok" if not probs else ",".join(probs)
            if probs:
                problems.append((path, st))
            print(f"{name + '.' + ext:26s} {kind:7s} {dur:7.3f} {exp:7.3f} {pk_db:9.2f} {rms_db:8.2f} "
                  f"{lead_ms:7.2f} {seam:>5s} {size / 1024:6.1f}  {st}")
            if ext == "ogg":
                sheets[kind].append((name, y, f"{dur:.2f}s  pk {pk_db:.1f}  rms {rms_db:.1f} dBFS"))
            elif kind == "music":
                off = mp3_raw_offset(path, ref)
                if off is not None:
                    mp3_offsets.append(off)
    print(f"\nTotal assets/audio size: {total_bytes / 1024 / 1024:.2f} MB")
    mp3_off = int(np.median(mp3_offsets)) if mp3_offsets else 1105
    print(f"MP3 raw (untrimmed) decoder offset: {mp3_off} samples = {mp3_off / SR * 1000:.2f} ms")

    manifest["format_note"] = (
        "Documentation only (the game does not read this file). All sounds live in assets/audio/ as "
        "<name>.ogg (Ogg Vorbis q4) and <name>.mp3 (MP3 96 kbit/s CBR), 44.1 kHz mono, synthesised by "
        "tools/audio/gen_audio.py with an NES 2A03-style model; all melodies are original. The game "
        "tries .ogg first, then .mp3. SFX and jingles are one-shots with no leading silence, peak "
        "-1 dBFS. Music files are exactly one loop body (loopStart 0, loopEnd = file length; the "
        "decoded .ogg is sample-exact) for <audio loop>; the last beat flows into the first. MP3 "
        f"fallback: the encoder adds ~{mp3_off} samples ({mp3_off / SR * 1000:.0f} ms) of delay and "
        "frame padding, so an MP3 loop may have a tiny gap; prefer .ogg. '_fast' variants are the same "
        "pieces re-rendered at 1.5x tempo (same pitch) for after the hurry jingle. Music RMS is about "
        "-17 dBFS, below the SFX.")
    with open(os.path.join(ASSETS, "audio.json"), "w") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")

    contact_sheet(sheets["sfx"], os.path.join(CHECK_DIR, "sfx_contact_sheet.png"),
                  "SFX (decoded .ogg): waveform (dotted = -1 dBFS) and spectrogram 0-8 kHz", cols=3)
    contact_sheet(sheets["jingles"], os.path.join(CHECK_DIR, "jingles_contact_sheet.png"),
                  "Jingles (decoded .ogg): waveform and spectrogram 0-8 kHz", cols=2)
    contact_sheet(sheets["music"], os.path.join(CHECK_DIR, "music_contact_sheet.png"),
                  "Music loops (decoded .ogg, first 20 s)", cols=2, max_s=20)

    if problems:
        print("\nPROBLEMS:")
        for p in problems:
            print("  ", *p)
        sys.exit(1)
    print("\nAll checks passed.")


if __name__ == "__main__":
    main()
