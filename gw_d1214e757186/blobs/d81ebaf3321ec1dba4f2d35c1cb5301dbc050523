    harm = diatonic_shift(a2, scale_pcs={2, 4, 6, 7, 9, 11, 1}, steps=-2)
    s.add("p2", harm, dict(duty=0.5, vol=6, decay=0.15, sustain=4, gate=0.85, release=2), at=128)

    pump = {8: [(k, "R" if k % 2 == 0 else "R8", 1) for k in range(8)],
            4: [(k, "R" if k % 2 == 0 else "R8", 1) for k in range(4)]}
    s.add("tri", bass_from_chords(chords, pump, low=38), dict(gate=0.6))

    beat = "k:1 h:1 s:1 h:1 k:1 k:1 s:1 h:1 "
    fill = "k:1 h:1 s:1 s:1 k:1 s:1 s:1 s:1 "
    s.add("noise", seq((beat * 7 + fill) * 3)[0], {})
    return s


def song_castle(bpm):
    """CASTLE - E minor / Phrygian colour, 160 bpm, straight 8ths, 16 bars.
    Chords: Em | Em | F | F | Em | Em | B7 | B7 | Am | Am | F | F | Em F | B7 | B7.
    Triangle gallops on the root (R R 8 R R R 8 5); pulse 2 shudders between each
    chord's fifth and the semitone above it; pulse 1 sings a slow, chromatic,
    vibrato-heavy line.  Bar 16 (B7, ending D#5) resolves back to the opening B4/Em."""
    s = Song(bpm=bpm, total=128)
    melody = ("B4:4 E5:4 G5:6 F#5:2  F5:8 E5:4 C5:4  B4:4 E5:4 G5:4 B5:4  A5:6 G5:2 F#5:4 D#5:4 "
              "C6:6 B5:2 A5:4 E5:4  F5:6 G5:2 A5:4 C6:4  B5:4 G5:4 A5:4 F5:4  "
              "D#5:4 F#5:4 A5:2 F#5:2 D#5:4")
    chords = chord_list("Em:16 F:16 Em:16 B7:16 Am:16 F:16 Em:8 F:8 B7:16")
    s.add("p1", seq(melody)[0], dict(duty=0.5, vol=11, decay=0.06, sustain=7, gate=0.93, release=4,
                                     vib=(0.35, 5.0, 0.3)))
    shudder = []
    for pos, ln, sym in chords:
        pc, _ = parse_chord(sym)
        fifth = 64 + ((pc + 7 - 64) % 12)               # chord fifth in E4..D#5
        for k in range(int(ln)):
            shudder.append((pos + k, 1, fifth + (k % 2)))
    s.add("p2", shudder, dict(duty=0.125, vol=5, decay=0.5, gate=0.6, release=1))
    gallop = [(0, "R", 1), (1, "R", 1), (2, "R8", 1), (3, "R", 1), (4, "R", 1), (5, "R", 1),
              (6, "R8", 1), (7, "5", 1)]
    pat = {8: gallop, 16: gallop + [(o + 8, d, l) for o, d, l in gallop]}
    s.add("tri", bass_from_chords(chords, pat, low=40), dict(gate=0.55))
    bar = "k:2 t:2 k:2 t:1 t:1 "
    s.add("noise", seq(bar * 15 + "s:1 s:1 s:1 s:1 s:1 s:1 s:1 s:1")[0], {})
    return s


