# ----------------------------------------------------------------------------
# loudness, encoding, verification
# ----------------------------------------------------------------------------
def db(x):
    return 20 * math.log10(max(x, 1e-12))


def peak_rms(y):
    return float(np.max(np.abs(y))), float(np.sqrt(np.mean(y ** 2)))


def encode(y, base):
    """Write <base>.ogg (libvorbis q4) and <base>.mp3 (LAME 96 kbit/s CBR), 44.1 kHz mono."""
    raw = np.clip(y, -1, 1).astype("<f4").tobytes()
    common = [FFMPEG, "-hide_banner", "-loglevel", "error", "-y",
              "-f", "f32le", "-ar", str(SR), "-ac", "1", "-i", "pipe:0", "-map_metadata", "-1",
              "-ar", str(SR), "-ac", "1"]
    subprocess.run(common + ["-c:a", "libvorbis", "-q:a", "4", base + ".ogg"], input=raw, check=True)
    subprocess.run(common + ["-c:a", "libmp3lame", "-b:a", "96k", base + ".mp3"], input=raw, check=True)


def encode_checked(y, base, ceiling_db=-0.5):
    """Encode, then make sure lossy-codec overshoot did not push the decoded peak
    above ceiling_db (noisy sounds can gain ~1.5 dB in Vorbis); if it did, lower
    the gain by the excess and re-encode.  Returns the (possibly rescaled) signal."""
    for _ in range(4):
        encode(y, base)
        worst = max(db(peak_rms(decode(base + ext))[0]) for ext in (".ogg", ".mp3"))
        if worst <= ceiling_db:
            break
        y = y * 10 ** ((ceiling_db - 0.3 - worst) / 20)
    return y


def decode(path, extra=()):
    p = subprocess.run([FFMPEG, "-hide_banner", "-loglevel", "error", *extra, "-i", path,
                        "-f", "f32le", "-ac", "1", "-ar", str(SR), "pipe:1"],
                       stdout=subprocess.PIPE, check=True)
    return np.frombuffer(p.stdout, dtype="<f4").astype(float)


def mp3_raw_offset(path, ref):
    """Samples of encoder+decoder delay a decoder that ignores the LAME gapless
    header would see (measured by decoding without skipping and aligning)."""
    try:
        raw = decode(path, extra=("-flags2", "+skip_manual"))
    except subprocess.CalledProcessError:
        return None
    n = min(len(ref), SR)
    best, best_err = None, 1e9
    for off in range(0, 3000):
        seg = raw[off:off + n]
        if len(seg) < n:
            break
        err = float(np.mean((seg - ref[:n]) ** 2))
        if err < best_err:
            best, best_err = off, err
    return best


def contact_sheet(items, path, title, cols, max_s=None):
    """Waveform + spectrogram per item, small multiples (QA only)."""
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    rows = int(math.ceil(len(items) / cols))
    fig = plt.figure(figsize=(5.2 * cols, 2.9 * rows), facecolor="white")
    gs = fig.add_gridspec(rows * 2, cols, height_ratios=[1, 2.2] * rows, hspace=0.55, wspace=0.18)
    ink, muted = "#1f2328", "#6e7781"
    for i, (name, y, info) in enumerate(items):
        r, c = divmod(i, cols)
        if max_s:
            y = y[:int(max_s * SR)]
        t = np.arange(len(y)) / SR
        aw = fig.add_subplot(gs[2 * r, c])
        aw.plot(t, y, color=ink, linewidth=0.6)
        aw.set_xlim(0, t[-1] if len(t) else 1)
        aw.set_ylim(-1, 1)
        aw.set_title(f"{name}   {info}", fontsize=8, color=ink, loc="left")
        aw.axhline(10 ** (-1 / 20), color=muted, linewidth=0.5, linestyle=":")
        aw.axhline(-10 ** (-1 / 20), color=muted, linewidth=0.5, linestyle=":")
        aw.tick_params(labelsize=6, colors=muted)
        aw.set_xticklabels([])
        for sp in aw.spines.values():
            sp.set_color("#d0d7de")
        asg = fig.add_subplot(gs[2 * r + 1, c])
        pxx, _, _, im = asg.specgram(y, NFFT=1024, Fs=SR, noverlap=768, cmap="Blues")
        top = 10 * np.log10(pxx.max() + 1e-20)
        im.set_clim(top - 75, top)                 # 75 dB window below each item's max
        asg.set_ylim(0, 8000)
        asg.tick_params(labelsize=6, colors=muted)
        asg.set_ylabel("Hz  (x: seconds)", fontsize=6, color=muted)
        for sp in asg.spines.values():
            sp.set_color("#d0d7de")
    fig.subplots_adjust(top=1 - 0.7 / fig.get_figheight())
    fig.suptitle(title, fontsize=11, color=ink, x=0.01, y=1 - 0.1 / fig.get_figheight(), ha="left")
    fig.savefig(path, dpi=90, bbox_inches="tight")
    plt.close(fig)


