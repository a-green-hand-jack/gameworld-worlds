def sfx_powerup_appear(m):
    # bubbling sprout: semitone-stepped rise G4 -> G5 with fast wobble, echoed on p2
    rise = lambda t: mtof(67 + np.floor(np.clip(t / 0.5, 0, 1) * 12))
    m.put("p1", 0.0, pulse_note(0.55, rise, duty=0.5, vol=11, decay=0.12, vib=(0.6, 14.0, 0.0)))
    m.put("p2", 0.06, pulse_note(0.50, rise, duty=0.25, vol=4, decay=0.06, vib=(0.6, 14.0, 0.0)))


def sfx_powerup(m):
    # rising arpeggio in interleaved 1-5-3-8 groups climbing by whole tones
    t, step = 0.0, 0.046
    for base in (60, 62, 64, 66):
        for iv in (0, 7, 4, 12):
            m.put("p1", t, pulse_note(step, mtof(base + iv + 12), duty=0.5, vol=11, decay=0.1))
            m.put("p2", t + step / 2, pulse_note(step, mtof(base + iv + 12), duty=0.25, vol=4))
            t += step
    m.put("p1", t, pulse_note(0.12, mtof(66 + 24), duty=0.5, vol=11, decay=0.9))


def sfx_oneup(m):
