def song_overworld(bpm):
    """OVERWORLD - C major, 4/4, 8th-note grid with light swing (55:45), calypso feel.
    Form: A (8 bars) A' (8) B (8) = 24 bars, loops straight back to A.
    Hook: a pentatonic 'E G A G E' bounce on the clave-like onsets 0,2,3,5,7,
    sequenced up to the IV chord.  Bass is a tumbao-ish R..R5..8 pattern on the
    triangle, pulse 2 plays off-beat chord stabs, noise plays kick/snare/hat."""
    s = Song(bpm=bpm, swing=0.1, total=192)
    melody = (
        # A
        "E5:2 G5:1 A5:2 G5:2 E5:1  D5:2 E5:1 C5:3 r:2  A5:2 C6:1 D6:2 C6:2 A5:1  G5:2 A5:1 F5:3 r:2 "
        "E5:2 G5:1 A5:2 G5:2 E5:1  C6:2 B5:1 A5:2 E5:2 C5:1  D5:1 F#5:1 A5:1 C6:2 B5:1 A5:1 F#5:1 "
        "G5:3 F5:1 r:1 D5:1 B4:1 D5:1 "
        # A'
        "E5:2 G5:1 A5:2 G5:2 E5:1  D5:2 E5:1 C5:3 r:2  A5:2 C6:1 D6:2 C6:2 A5:1  G5:2 A5:1 F5:3 r:2 "
        "E5:2 G5:1 A5:2 G5:2 E5:1  C#6:2 B5:1 A5:2 E5:2 C#5:1  D5:1 F5:1 A5:1 C6:1 B5:2 G5:1 F5:1 "
        "E5:2 C5:1 G4:1 C5:2 r:2 "
        # B (call and response; pulse 2 answers in the gaps)
        "C6:1 r:1 C6:1 A5:1 r:1 F5:2 G5:1  A5:2 G5:1 F5:1 r:4  B5:1 r:1 B5:1 G5:1 r:1 E5:2 F5:1 "
        "G5:2 F5:1 E5:1 r:4  A5:1 r:1 A5:1 F5:1 r:1 D5:2 E5:1  F5:2 E5:1 D5:1 B4:1 D5:1 G5:2 "
        "E5:1 G5:1 C6:2 A5:1 F5:1 A5:2  F5:1 r:1 F5:1 G5:1 r:1 B4:1 C5:1 D5:1"
    )
    chords = chord_list(
        "C:8 C:8 F:8 F:8 C:8 Am:8 D7:8 G7:8 "
        "C:8 C:8 F:8 F:8 C:8 A7:8 Dm7:4 G7:4 C:8 "
        "F:8 F:8 Em:8 Am:8 Dm:8 G:8 C:4 F:4 G7:8")
    lead = dict(duty=0.5, vol=11, decay=0.2, sustain=6, gate=0.88, release=3, vib=(0.25, 5.5, 0.22))
    s.add("p1", seq(melody)[0], lead)

    # pulse 2: off-beat stabs, replaced by answer licks in bars 18 and 20
    stab = dict(duty=0.25, vol=6, decay=0.7, gate=0.55, release=1)
    answer = dict(duty=0.25, vol=8, decay=0.25, sustain=3, gate=0.8, release=2)
    lick_pos = {17 * 8: "A4:1 C5:1 D5:1 F5:1", 19 * 8: "C5:1 B4:1 A4:1 B4:1"}
    stabs = stabs_from_chords(chords, offsets=(1, 3, 5, 7))
    stabs = [e for e in stabs if not any(b + 4 <= e[0] < b + 8 for b in lick_pos)]
    s.add("p2", stabs, stab)
    for b, lick in lick_pos.items():
        s.add("p2", seq(lick)[0], answer, at=b + 4)

    bass_pat = {8: [(0, "R", 3), (3, "R", 1), (4, "5", 3), (7, "R8", 1)],
                4: [(0, "R", 3), (3, "5", 1)]}
    s.add("tri", bass_from_chords(chords, bass_pat, low=41), dict(gate=0.6, gate_max=0.32))

    groove = "k:1 h:1 s:1 k:1 h:1 h:1 s:1 h:1 "
    fill = "k:1 h:1 s:1 k:1 s:1 s:1 s:1 s:1 "
    s.add("noise", seq((groove * 7 + fill) * 3)[0], {})
    return s


def song_underground(bpm):
    """UNDERGROUND - A minor, 150 bpm, 8th grid, straight.  Form: A (8 bars) A' (8).
    A low staccato pulse riff (triad climb + chromatic lower neighbour, lots of
    rests) doubled an octave down on the triangle.  In A, pulse 2 is a quiet
    one-8th 'cave echo' an octave up; in A' it becomes high water-drip plinks.
    The last bar walks E7 back to the A minor start."""
    s = Song(bpm=bpm, total=128)
    m1 = "A3:1 r:2 A3:1 C4:1 r:1 E4:1 r:1  D#4:1 r:1 E4:1 r:5 "
    m2 = "G3:1 r:2 G3:1 B3:1 r:1 D4:1 r:1  C#4:1 r:1 D4:1 r:5 "
    m3 = "F3:1 r:2 F3:1 A3:1 r:1 C4:1 r:1  B3:1 r:1 C4:1 r:1 B3:1 r:1 A3:1 r:1 "
    m4 = "E3:1 r:1 E4:1 r:1 G#3:1 r:1 B3:1 r:1  D4:1 r:1 C4:1 r:1 B3:1 r:1 G#3:1 r:1 "
    m4b = "E3:1 r:1 E4:1 r:1 G#3:1 r:1 B3:1 r:1  D4:1 r:1 F4:1 r:1 E4:1 r:1 E3:1 r:1 "
    riff_a, _ = seq(m1 + m2 + m3 + m4)
    riff_b, _ = seq(m1 + m2 + m3 + m4b)
    bass = dict(duty=0.5, vol=12, decay=0.9, gate=0.5, release=2)
    s.add("p1", riff_a, bass)
    s.add("p1", riff_b, dict(bass, duty=0.25), at=64)
    s.add("tri", riff_a, dict(gate=0.45, transpose=-12))
    s.add("tri", riff_b, dict(gate=0.45, transpose=-12), at=64)

    # A: echo of the riff, one step late, an octave up, very quiet
    s.add("p2", riff_a, dict(duty=0.125, vol=3, decay=0.4, gate=0.5, release=1), at=1, transpose=12)
    # A': drips (own sparse counter-line), with a small downward 'plink' slide
    drips = ("r:4 E6:4  r:8  r:2 D6:3 B5:3  r:8  r:4 C6:4  A5:2 r:6  r:2 G#5:2 B5:2 D6:2  E6:4 r:4")
    s.add("p2", seq(drips)[0], dict(duty=0.25, vol=6, decay=0.35, gate=0.7, release=3,
                                   slide=(1.5, 0.035), vib=(0.2, 6, 0.15)), at=64)
    tick_a = "r:6 t:2 " * 8
    tick_b = "r:2 t:4 t:2 " * 7 + "r:2 t:2 t:2 k:2"
    s.add("noise", seq(tick_a + tick_b)[0], {})
    return s


def song_star(bpm):
    """STAR - D major, 210 bpm, straight 8ths, driving.  Form: A (8) B (8) A' (8).
    Lead: bright arpeggio runs (A), a repeated-shape climb through G A F#m Bm
    (B), A' repeats A with pulse 2 harmonising a diatonic third below.  Triangle
    pumps octaves on every 8th, noise plays a busy kick/snare/hat beat."""
    s = Song(bpm=bpm, total=192)
    a_mel = ("D5:1 F#5:1 A5:1 D6:2 C#6:1 B5:1 A5:1  B5:2 A5:1 F#5:2 E5:1 F#5:2 "
             "G5:1 B5:1 D6:1 G6:2 F#6:1 E6:1 D6:1  E6:2 C#6:1 A5:2 B5:1 C#6:2 "
             "D6:1 r:1 A5:1 F#5:1 D6:1 r:1 A5:1 F#5:1  B5:1 F#5:1 D5:1 F#5:1 B5:2 A5:2 "
             "E5:1 G5:1 B5:1 E6:1 C#6:1 B5:1 A5:1 G5:1 ")
    a_end1 = "F#5:2 A5:1 D6:3 r:2 "
    a_end2 = "F#5:2 A5:1 D6:2 A5:1 E5:1 C#5:1 "
    b_mel = ("D6:1 r:1 D6:1 B5:1 r:1 G5:1 B5:1 D6:1  C#6:1 r:1 C#6:1 A5:1 r:1 E5:1 A5:1 C#6:1 "
             "A5:1 r:1 A5:1 F#5:1 r:1 C#5:1 F#5:1 A5:1  B5:2 D6:2 F#6:2 E6:1 D6:1 "
             "B5:1 G5:1 B5:1 D6:1 G6:2 F#6:1 E6:1  C#6:1 A5:1 C#6:1 E6:1 A6:2 G6:1 E6:1 "
             "G6:1 E6:1 B5:1 G5:1 A5:1 C#6:1 E6:1 G6:1  F#6:2 D6:1 A5:1 D6:2 r:2")
    a_chords = "D:8 D:8 G:8 A:8 D:8 Bm:8 Em:4 A:4 D:8 "
    b_chords = "G:8 A:8 F#m:8 Bm:8 G:8 A:8 Em:4 A7:4 D:8 "
