def jingle_hurry(m):
    # three urgent rising siren bursts (C6/G5, D6/A5, E6/B5) then a repeated F6 alarm
    s16 = 0.055
    t = 0.0
    for k, base in enumerate((84, 86, 88)):
        for i in range(8):
            note = base if i % 2 == 0 else base - 5
            m.put("p1", t + i * s16, pulse_note(s16, mtof(note), duty=0.25, vol=12, decay=0.4))
            m.put("p2", t + i * s16, pulse_note(s16, mtof(note - 12), duty=0.125, vol=6))
        m.put("tri", t, tri_note(0.09, mtof(48 + 2 * k)))
        m.put("tri", t + 0.22, tri_note(0.09, mtof(48 + 2 * k)))
        m.put("noise", t, noise_note(**DRUMS["s"]))
        t += 8 * s16 + 0.11
    for i in range(3):
        m.put("p1", t + i * 0.1, pulse_note(0.07, mtof(89), duty=0.25, vol=13, decay=0.5))
        m.put("p2", t + i * 0.1, pulse_note(0.07, mtof(84), duty=0.5, vol=7, decay=0.5))
    t += 0.3
    m.put("p1", t, pulse_note(0.32, mtof(89), duty=0.25, vol=13, decay=0.25, vib=(0.5, 9, 0)))
    m.put("p2", t, pulse_note(0.32, mtof(84), duty=0.5, vol=7, decay=0.15))
    m.put("tri", t, tri_note(0.3, mtof(41)))
    m.put("noise", t, noise_note(**DRUMS["c"]))


