    lead = dict(duty=0.25, vol=12, decay=0.15, sustain=7, gate=0.85, release=2, vib=(0.2, 6, 0.2))
    s.add("p1", seq(a_mel + a_end1 + b_mel)[0], lead)
    a2, _ = seq(a_mel + a_end2)
    s.add("p1", a2, dict(lead, duty=0.5), at=128)

    arp = dict(duty=0.125, vol=6, decay=0.6, gate=0.5, release=1)
