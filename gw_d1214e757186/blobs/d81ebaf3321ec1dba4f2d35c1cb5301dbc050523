# ----------------------------------------------------------------------------
# pitch helpers
# ----------------------------------------------------------------------------
_PC = {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}


def note_to_midi(name):
    """'C#5', 'Bb4', 'E2' -> MIDI number (C4 = 60)."""
    pc = _PC[name[0].upper()]
    i = 1
    while i < len(name) and name[i] in "#b":
        pc += 1 if name[i] == "#" else -1
        i += 1
    return 12 * (int(name[i:]) + 1) + pc


def mtof(m):
    return 440.0 * 2.0 ** ((np.asarray(m, dtype=float) - 69.0) / 12.0)


def quantize_pulse(f):
    """Snap frequencies to what the pulse 11-bit timer can produce."""
    t = np.clip(np.round(CPU_HZ / (16.0 * np.maximum(f, 1.0)) - 1.0), 8, 2047)
    return CPU_HZ / (16.0 * (t + 1.0))


def quantize_tri(f):
    t = np.clip(np.round(CPU_HZ / (32.0 * np.maximum(f, 1.0)) - 1.0), 2, 2047)
    return CPU_HZ / (32.0 * (t + 1.0))


# ----------------------------------------------------------------------------
# oscillators (return DAC-level waveforms in 0..1 or 0..15)
# ----------------------------------------------------------------------------
def _blep(t, dt):
    """polyBLEP residual for a unit step located at phase 0."""
    out = np.zeros_like(t)
    m = t < dt
    x = t[m] / dt[m]
    out[m] = x + x - x * x - 1.0
    m = t > 1.0 - dt
    x = (t[m] - 1.0) / dt[m]
    out[m] = x * x + x + x + 1.0
    return out


def osc_pulse(freq, duty):
    """Band-limited unipolar pulse (0..1). freq: per-sample array in Hz."""
    dt = np.minimum(freq / SR, 0.5)
    ph = (np.cumsum(dt) - dt) % 1.0
    y = (ph < duty).astype(float)
    y += 0.5 * _blep(ph, dt)                    # rising edge at phase 0
    y -= 0.5 * _blep((ph - duty) % 1.0, dt)     # falling edge at phase = duty
    return y


TRI_TABLE = np.array(list(range(15, -1, -1)) + list(range(0, 16)), dtype=float)


def osc_triangle(freq):
    """NES 32-step triangle, starting at the 0 level (phase 0.5) so notes never click."""
    dt = freq / SR
    ph = (0.5 + np.cumsum(dt) - dt) % 1.0
    return TRI_TABLE[(ph * 32).astype(int) % 32]


NOISE_PERIODS = [4, 8, 16, 32, 64, 96, 128, 160, 202, 254, 380, 508, 762, 1016, 2034, 4068]
_LFSR_CACHE = {}


def _lfsr_sequence(short):
    """One full period of the 2A03 noise LFSR output (1 = sound, 0 = silent)."""
    if short in _LFSR_CACHE:
        return _LFSR_CACHE[short]
    tap = 6 if short else 1
    reg, out = 1, []
    while True:
        out.append(1 - (reg & 1))
        fb = (reg & 1) ^ ((reg >> tap) & 1)
        reg = (reg >> 1) | (fb << 14)
        if reg == 1:
            break
    seq = np.array(out, dtype=float)
    cs = np.concatenate([[0.0], np.cumsum(seq)])
    _LFSR_CACHE[short] = (seq, cs)
    return seq, cs


def osc_noise(rate, short=False):
    """LFSR noise, box-filtered per output sample (cheap anti-aliasing).
    rate: per-sample array of LFSR clocks per second."""
    seq, cs = _lfsr_sequence(short)
    L, total = len(seq), cs[-1]
    r = rate / SR                               # LFSR clocks per output sample
    c1 = np.cumsum(r)
    c0 = c1 - r

    def integral(x):                            # integral of the step sequence 0..x
        n = np.floor(x)
        i = (n % L).astype(int)
        return (n // L) * total + cs[i] + (x - n) * seq[i]

    return (integral(c1) - integral(c0)) / r


# ----------------------------------------------------------------------------
# envelopes / modulation
# ----------------------------------------------------------------------------
def envelope(n, gate, vol=12.0, decay=0.0, sustain=0.0, attack=0, release=0):
    """NES-like stepped volume envelope, evaluated once per 60 Hz frame.
    vol: start level 0..15, decay: levels lost per frame, sustain: floor while
    gated, attack: frames of linear rise, release: frames to fall to 0 after
    the gate (0 = cut).  Returns per-sample integer levels 0..15."""
    frames = int(math.ceil(n / FRAME)) + 2
    k = np.arange(frames, dtype=float)
    v = np.maximum(vol - decay * np.maximum(k - attack, 0), min(sustain, vol))
    if attack > 0:
        v = np.where(k < attack, vol * (k + 1) / (attack + 1), v)
    gate_f = gate / FRAME
    gi = min(int(gate_f), frames - 1)
    if release > 0:
        rel = v[gi] * (1.0 - (k - gate_f) / release)
        v = np.where(k >= gate_f, np.maximum(rel, 0.0), v)
    else:
        v = np.where(k >= gate_f, 0.0, v)
    v = np.clip(np.floor(v + 0.5), 0, 15)
    return v[(np.arange(n) / FRAME).astype(int)]


def freq_curve(n, freq, vib=None, slide=None, step_hz=None):
    """Per-sample frequency array.
    freq   : Hz scalar or callable f(t_seconds_array) -> Hz
    vib    : (depth_semitones, rate_hz, delay_s) vibrato
    slide  : (semitones, seconds) start offset that glides to 0 (pitch 'plink')
    step_hz: update the pitch only at this rate (NES sweep unit ~120 Hz)."""
    t = np.arange(n) / SR
    if step_hz:
        t = np.floor(t * step_hz) / step_hz
    f = freq(t) if callable(freq) else np.full(n, float(freq))
    semis = np.zeros(n)
    if vib:
        depth, rate, delay = vib
        ramp = np.clip((t - delay) / 0.15, 0, 1)
        semis += depth * ramp * np.sin(2 * np.pi * rate * t)
    if slide:
        st, sd = slide
        semis += st * np.clip(1 - t / sd, 0, 1)
    return f * 2.0 ** (semis / 12.0)


# ----------------------------------------------------------------------------
# note renderers -> DAC-level segments
# ----------------------------------------------------------------------------
def pulse_note(dur, freq, duty=0.5, vol=12, decay=0.0, sustain=0, attack=0, release=0,
               vib=None, slide=None, step_hz=None, tremolo=None, **_):
    """One pulse-channel note.  dur = gate time in seconds."""
    gate = int(round(dur * SR))
    n = gate + int(release * FRAME) + 1
    f = quantize_pulse(freq_curve(n, freq, vib, slide, step_hz))
    env = envelope(n, gate, vol, decay, sustain, attack, release)
    if tremolo:                                  # (rate_hz, depth 0..1), frame-stepped
        rate, depth = tremolo
        tf = np.floor(np.arange(n) / FRAME) / 60.0
        env = np.floor(env * (1 - depth * (0.5 + 0.5 * np.sign(np.sin(2 * np.pi * rate * tf)))) + 0.5)
    return osc_pulse(f, duty) * env


def tri_note(dur, freq, vib=None, slide=None, step_hz=None, **_):
    """Triangle note: full level while gated, ends on the next zero step (no click)."""
    gate = int(round(dur * SR))
    pad = int(SR / 20)                           # up to one period of a 20 Hz note
    f = quantize_tri(freq_curve(gate + pad, freq, vib, slide, step_hz))
    y = osc_triangle(f)
    zeros = np.nonzero(y[gate:] == 0)[0]
    end = gate + (zeros[0] if len(zeros) else pad)
    return y[:end + 1] * (np.arange(end + 1) < end)


def noise_note(dur, period=8, short=False, vol=12, decay=1.0, sustain=0, attack=0, release=0,
               stutter=None, **_):
    """Noise note.  period: NES period index, or a list of indices (one per frame)
    for pitch-swept drums.  stutter: per-frame volume multipliers (crackle)."""
    gate = int(round(dur * SR))
    n = gate + int(release * FRAME) + 1
    fi = (np.arange(n) / FRAME).astype(int)
    if np.isscalar(period):
        rate = np.full(n, CPU_HZ / NOISE_PERIODS[int(period)])
    else:
        idx = np.array(period)[np.minimum(fi, len(period) - 1)]
        rate = CPU_HZ / np.array(NOISE_PERIODS, float)[idx]
    env = envelope(n, gate, vol, decay, sustain, attack, release)
    if stutter is not None:
        st = np.array(stutter, float)
        env = np.floor(env * st[fi % len(st)] + 0.5)
    return osc_noise(rate, short) * env


# ----------------------------------------------------------------------------
# channel buffers, NES mixer and output filter
# ----------------------------------------------------------------------------
CHANNELS = ("p1", "p2", "tri", "noise")


class Mix:
    """Four monophonic channel buffers.  Writing a note overwrites whatever the
    channel was doing from that sample on (like the real hardware)."""

    def __init__(self, n=0):
        self.buf = {c: np.zeros(n) for c in CHANNELS}

    def put(self, ch, start_s, seg, at_sample=None):
        s = int(round(start_s * SR)) if at_sample is None else int(at_sample)
        b = self.buf[ch]
        if s + len(seg) > len(b):
            grow = s + len(seg) - len(b)
            for c in CHANNELS:
                self.buf[c] = np.concatenate([self.buf[c], np.zeros(grow)])
            b = self.buf[ch]
        b[s:s + len(seg)] = seg

    def out(self):
        return nes_mix(*(self.buf[c] for c in CHANNELS))


def nes_mix(p1, p2, tri, noi):
    """2A03 non-linear mixer (nesdev formulas, rewritten to be stable at 0)."""
    s = p1 + p2
    pulse = 95.88 * s / (8128.0 + 100.0 * s)
    x = tri / 8227.0 + noi / 12241.0
    tnd = 159.79 * x / (1.0 + 100.0 * x)
    return pulse + tnd


_HP = butter(1, 40.0, "highpass", fs=SR)
_LP = butter(1, 14000.0, "lowpass", fs=SR)


def output_stage(y):
    """Console-like analogue output: DC-blocking high-pass + mild low-pass."""
    return lfilter(*_LP, lfilter(*_HP, y))


# ----------------------------------------------------------------------------
# tiny tracker / sequencer
# ----------------------------------------------------------------------------
def seq(tokens):
    """Parse 'E5:2 G5:1 r:1 k:1' -> ([(pos, len, note)], total_len).
    note is a MIDI int, a drum name (str) or None for rests; len in grid steps."""
    evs, pos = [], 0.0
    for tok in tokens.split():
        name, ln = tok.split(":")
        ln = float(ln)
        if name != "r":
            note = name if name in DRUMS else note_to_midi(name)
            evs.append((pos, ln, note))
        pos += ln
    return evs, pos


# chord symbol -> (root pitch class, intervals)
_QUAL = {"": (0, 4, 7), "m": (0, 3, 7), "7": (0, 4, 7, 10), "m7": (0, 3, 7, 10), "maj7": (0, 4, 7, 11)}


def parse_chord(sym):
    root = sym[0]
    i = 1
    if len(sym) > 1 and sym[1] in "#b":
        i = 2
    pc = (note_to_midi(sym[:i] + "4") - 60) % 12
    return pc, _QUAL[sym[i:]]


def chord_list(tokens):
    """'C:8 F:4 G7:4' -> [(pos, len, symbol)]."""
    out, pos = [], 0.0
    for tok in tokens.split():
        sym, ln = tok.split(":")
        out.append((pos, float(ln), sym))
        pos += float(ln)
    return out


def bass_from_chords(chords, patterns, low=40):
    """Triangle bass from a chord list.  patterns: {chord_len: [(offset, degree, len)]}
    degree: 'R' root, '5' fifth above, '3' third, 'R8' octave up.  Roots are placed
    in [low, low+12)."""
    evs = []
    for pos, ln, sym in chords:
        pc, ivs = parse_chord(sym)
        root = low + ((pc - low) % 12)
        deg = {"R": root, "3": root + ivs[1], "5": root + 7, "R8": root + 12, "5-": root - 5}
        for off, d, l in patterns[int(ln)]:
            evs.append((pos + off, l, deg[d]))
    return evs


def chord_tones_in(sym, lo, hi):
    pc, ivs = parse_chord(sym)
    return [m for m in range(lo, hi) if (m - pc) % 12 in ivs]


def stabs_from_chords(chords, offsets, lo=67, hi=78, skip_root=True):
    """Off-beat 'skank' stabs for one pulse voice: alternates two upper chord tones."""
    evs = []
    for pos, ln, sym in chords:
        pc, ivs = parse_chord(sym)
        tones = [m for m in chord_tones_in(sym, lo, hi) if not (skip_root and (m - pc) % 12 == 0)]
        pair = [tones[0], tones[1]] if len(tones) > 1 else tones * 2
        for j, off in enumerate([o for o in offsets if o < ln]):
            evs.append((pos + off, 1, pair[j % 2]))
    return evs


def arps_from_chords(chords, shape, lo, hi):
    """8th-note chord arpeggio: shape indexes into the chord tones within [lo, hi)."""
    evs = []
    for pos, ln, sym in chords:
        tones = chord_tones_in(sym, lo, hi)
        for k in range(int(ln)):
            evs.append((pos + k, 1, tones[shape[k % len(shape)] % len(tones)]))
    return evs


def diatonic_shift(evs, scale_pcs, steps):
    """Move each note `steps` scale degrees (negative = down) for parallel harmony."""
    scale = [m for m in range(24, 110) if m % 12 in scale_pcs]
    out = []
    for p, l, m in evs:
        if m in scale:
            out.append((p, l, scale[scale.index(m) + steps]))
    return out


class Song:
    """A grid-based multi-channel pattern.  Positions are in grid steps;
    steps_per_beat=2 means 8th-note steps.  swing lengthens the first step of
    every pair (0.1 -> 55:45)."""

    def __init__(self, bpm, steps_per_beat=2, swing=0.0, total=None):
        self.bpm, self.spb, self.swing, self.total = bpm, steps_per_beat, swing, total
        self.events = []                     # (ch, pos, len, note, inst)

    def add(self, ch, evs, inst, at=0.0, transpose=0):
        for p, l, n in evs:
            if isinstance(n, (int, np.integer)):
                n = int(n) + transpose
            self.events.append((ch, at + p, l, n, inst))
        return self

    def time_at(self, pos):
        """Grid position -> seconds (piecewise-linear swing mapping)."""
        dt = 60.0 / self.bpm / self.spb
        s = self.swing
        pair = math.floor(pos / 2.0)
        f = pos - 2 * pair
        t = 2 * pair + (f * (1 + s) if f < 1 else (1 + s) + (f - 1) * (1 - s))
        return t * dt

    def length_s(self):
        return self.time_at(self.total)

    def write(self, mix, offset_samples=0, copies=1, period_samples=0):
        """Render all events into `mix`, repeated `copies` times period_samples apart."""
        evs = sorted(self.events, key=lambda e: e[1])
        for c in range(copies):
            base = offset_samples + c * period_samples
            for ch, pos, ln, note, inst in evs:
                t0 = self.time_at(pos)
                span = self.time_at(pos + ln) - t0
                gate = min(span * inst.get("gate", 1.0), inst.get("gate_max", 1e9))
                start = base + int(round(t0 * SR))
                if ch == "noise":
                    d = dict(DRUMS[note])
                    d.update({k: v for k, v in inst.items() if k in ("vol_scale",)})
                    vs = d.pop("vol_scale", 1.0)
                    d["vol"] = d["vol"] * vs
                    seg = noise_note(d.pop("dur"), **d)
                elif ch == "tri":
                    seg = tri_note(gate, mtof(note + inst.get("transpose", 0)), **inst)
                else:
                    seg = pulse_note(gate, float(mtof(note + inst.get("transpose", 0))), **inst)
                mix.put(ch, 0, seg, at_sample=start)


# noise-channel drum kit (period index per frame for pitched drums)
DRUMS = {
    "k": dict(dur=0.07, period=[6, 9, 11, 12, 13], vol=13, decay=2.2),       # kick / thump
    "s": dict(dur=0.12, period=6, vol=11, decay=1.1),                          # snare
    "h": dict(dur=0.03, period=1, vol=5, decay=2.0),                           # closed hat
    "o": dict(dur=0.12, period=1, vol=5, decay=0.5),                           # open hat
    "c": dict(dur=0.9, period=3, vol=10, decay=0.2),                           # crash
    "t": dict(dur=0.04, period=4, short=True, vol=6, decay=2.0),               # metallic tick
}


def render_loop(song):
    """Render one seamless loop body.  Three back-to-back copies are rendered and
    filtered and the middle copy is returned, so note tails and filter state wrap
    around exactly: played with <audio loop>, end flows into start sample-accurately."""
    N = int(round(song.length_s() * SR))
    mix = Mix(3 * N)
    song.write(mix, copies=3, period_samples=N)
    y = output_stage(mix.out())
    return y[N:2 * N].copy()


def finish_oneshot(y, fade_ms=8.0, floor_db=-60.0):
    """Trim leading/trailing near-silence and add a tiny fade-out."""
    thr = np.max(np.abs(y)) * 10 ** (floor_db / 20)
    idx = np.nonzero(np.abs(y) > thr)[0]
    y = y[idx[0]:idx[-1] + 1].copy()
    nf = min(len(y), int(fade_ms * SR / 1000))
    y[-nf:] *= np.linspace(1, 0, nf)
    return y


def render_oneshot(build):
    """build(mix) writes notes into a Mix; returns filtered, trimmed audio."""
    mix = Mix(0)
    build(mix)
    y = output_stage(np.concatenate([mix.out(), np.zeros(int(0.05 * SR))]))
    return finish_oneshot(y)


# ----------------------------------------------------------------------------
# SOUND EFFECTS (generic synth effects, own parameters)
# ----------------------------------------------------------------------------
def exp_glide(f0, f1, dur):
    """Exponential frequency glide f0 -> f1 over dur seconds, then hold."""
    return lambda t: f0 * (f1 / f0) ** np.clip(t / dur, 0, 1)


def sfx_jump_small(m):
    m.put("p1", 0, pulse_note(0.19, exp_glide(320, 980, 0.19), duty=0.25, vol=12, decay=0.55, step_hz=120))


def sfx_jump_big(m):
    # lower start, 50 % duty, plus a slightly detuned 25 % voice for a fuller tone
    m.put("p1", 0, pulse_note(0.24, exp_glide(190, 560, 0.24), duty=0.5, vol=13, decay=0.5, step_hz=120))
    m.put("p2", 0, pulse_note(0.22, exp_glide(191.5, 566, 0.22), duty=0.25, vol=6, decay=0.3, step_hz=120))


