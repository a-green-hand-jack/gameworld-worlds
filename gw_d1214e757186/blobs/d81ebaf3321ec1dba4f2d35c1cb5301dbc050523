# ----------------------------------------------------------------------------
# constants / paths
# ----------------------------------------------------------------------------
SR = 44100
CPU_HZ = 1789773.0                 # NTSC 2A03 CPU clock
FRAME = SR / 60.0                  # one NES video frame in samples (envelope tick)

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
