"""Write assets/manifest.js: every file the game can load from assets/ (rerun after changing assets)."""
import os, json
root = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'assets')
files = sorted(os.path.relpath(os.path.join(d, f), root).replace(os.sep, '/')
               for d, _, fs in os.walk(root) for f in fs
               if f.endswith(('.png', '.ogg', '.mp3', '.wav')))
with open(os.path.join(root, 'manifest.js'), 'w') as out:
    out.write('// Generated by tools/manifest.py: every file under assets/ the game may load.\n')
    out.write('window.SMB_ASSET_FILES = ' + json.dumps(files, indent=1) + ';\n')
print(len(files), 'files')
