import wave, struct, math, random
from PIL import Image, ImageDraw
SR=22050
def tone(segs, vol=0.5):
    out=[]
    for f,d,shape in segs:
        n=int(SR*d)
        for i in range(n):
            t=i/SR; env=min(1,i/(SR*0.005))*(1-i/n)
            if f==0: v=0
            elif shape=='sq': v=1 if math.sin(2*math.pi*f*t)>=0 else -1
            else: v=math.sin(2*math.pi*f*t)
            out.append(v*env*vol)
    return out
def save(name,s):
    with wave.open(f'assets/audio/{name}.wav','wb') as w:
        w.setnchannels(1);w.setsampwidth(2);w.setframerate(SR)
        w.writeframes(b''.join(struct.pack('<h',int(max(-1,min(1,x))*32000)) for x in s))
save('paddle',tone([(480,0.07,'sq')]))
save('wall',tone([(240,0.06,'sq')]))
save('score',tone([(660,0.1,'sq'),(440,0.1,'sq'),(300,0.18,'sq')]))
save('win',tone([(523,0.12,'sq'),(659,0.12,'sq'),(784,0.12,'sq'),(1047,0.4,'sq')]))
save('lose',tone([(392,0.18,'sq'),(330,0.18,'sq'),(262,0.18,'sq'),(196,0.5,'sq')]))
