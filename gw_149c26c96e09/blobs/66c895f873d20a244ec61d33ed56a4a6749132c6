import sys, subprocess, time
from playwright.sync_api import sync_playwright
root=sys.argv[1]
srv=subprocess.Popen([sys.executable,'-m','http.server','8769','-d',root],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); time.sleep(1)
with sync_playwright() as p:
    b=p.chromium.launch(); pg=b.new_page()
    pg.goto('http://localhost:8769/'); pg.wait_for_timeout(1200)
    pg.evaluate("""()=>{window._log=[];const s=SnakeGame.game;document.getElementById('restart-button').addEventListener('click',()=>{window._log.push(['click',performance.now()-s.overAt,s.state])},true)}""")
    pg.keyboard.press('Enter'); pg.wait_for_timeout(100); pg.keyboard.press('ArrowUp')
    while pg.evaluate('SnakeGame.game.state')=='playing': pg.wait_for_timeout(5)
    box=pg.locator('#restart-button').bounding_box()
    for i in range(20):
        pg.mouse.click(box['x']+box['width']/2, box['y']+box['height']/2)
        if pg.evaluate('SnakeGame.game.state')=='playing': break
        pg.wait_for_timeout(40)
    print(pg.evaluate('window._log')[-3:])
    b.close()
srv.terminate()
