:root {
  --bg: #10141c;
  --board: #18202c;
  --grid: #1e2836;
  --wall: #3c4a5e;
  --text: #e8edf4;
  --muted: #8a97a8;
  --accent: #6bd36b;
  --danger: #e85d5d;
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  display: flex; align-items: center; justify-content: center;
}
#game { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 12px; }
#hud {
  width: min(528px, 92vw, 80vh); display: flex; justify-content: space-between;
  font-size: 20px; letter-spacing: 0.04em;
}
#hud[hidden] { display: flex; visibility: hidden; }
#hud strong { color: var(--accent); }
#stage { position: relative; width: min(528px, 92vw, 80vh); aspect-ratio: 1 / 1; }
#board {
  width: 100%; height: 100%; display: block;
  image-rendering: pixelated; border-radius: 6px;
  box-shadow: 0 0 0 2px var(--grid), 0 8px 30px rgba(0,0,0,0.5);
}
.screen {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; gap: 8px;
  background: rgba(10, 14, 20, 0.82); border-radius: 6px; padding: 20px;
}
.screen[hidden] { display: none; }
.screen h1 { font-size: 64px; margin: 0; letter-spacing: 0.12em; color: var(--accent); }
.screen h2 { font-size: 42px; margin: 0; color: var(--danger); }
#pause-screen h2 { color: var(--text); }
#title-logo { max-width: 80%; max-height: 40%; image-rendering: pixelated; }
.screen p { margin: 4px 0; line-height: 1.4; }
.final { font-size: 26px; }
.final strong { color: var(--accent); }
.hint { color: var(--muted); font-size: 14px; }
button {
  font: inherit; font-size: 22px; padding: 10px 28px; margin-top: 8px;
  background: var(--accent); color: #0b1a0b; border: 0; border-radius: 6px; cursor: pointer;
}
button:hover, button:focus-visible { filter: brightness(1.12); outline: 2px solid var(--text); outline-offset: 2px; }
button:disabled { opacity: 0.45; cursor: default; filter: none; }
