import time, os
os.environ['PLAYWRIGHT_BROWSERS_PATH']='/hutian/pw'
from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    b=p.chromium.launch(); pg=b.new_page(viewport={'width':700,'height':440})
    pg.goto('file:///hutian/work/index.html?manual'); pg.wait_for_function("game.ready")
    pg.evaluate("game.keys.right=true")
    seen=set()
    for i in range(120):
        pg.evaluate("game.step(1)")
        d=pg.evaluate("[game.player.x,game.player.y,game.state,game.frame]")
        if d[1]>300: seen.add('fell'); 
        if d[3]<3 and i>5: seen.add('restarted'); break
    print('walk right no jump ->',seen,d)
    pg.screenshot(path='shots/neg_fall.png')
    # no-jump walk to flag across solid ground impossible; check tall wall? 
    b.close()
