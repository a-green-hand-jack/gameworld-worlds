#!/usr/bin/env python3
"""Write every graphics file the game loads, at the names and sizes fixed in
`docs/assets.md` of world/game-developer (the art/build contract).

Run:  python3 tools/gfx/export.py
Writes assets/tiles/<theme>/*.png, assets/scenery/*.png, assets/sprites/*.png,
assets/ui/*.png, and review images in tools/gfx/check/ (not delivered).
"""
import os
import sys

from PIL import Image

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
OUT = os.path.join(ROOT, "assets")
CHECK = os.path.join(HERE, "check")

from nes import rgb, check, render, hflip, transpose  # noqa: E402
from scenery import bottom_align, puff_shape, hill_shape  # noqa: E402
import art_mario as AM  # noqa: E402
import art_world as AW  # noqa: E402
import art_world1 as A1  # noqa: E402
import art_world2 as A2  # noqa: E402
import art_text as AT  # noqa: E402
import bowser  # noqa: E402

WRITTEN = []


def save(im, rel):
    path = os.path.join(OUT, rel)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    im.save(path, optimize=True)
    WRITTEN.append((rel, im.size))


def strip(images):
    w, h = images[0].size
    for im in images:
        assert im.size == (w, h), f"frame size {im.size} != {(w, h)}"
    out = Image.new("RGBA", (w * len(images), h), (0, 0, 0, 0))
    for i, im in enumerate(images):
        out.paste(im, (i * w, 0))
    return out


def crop_cols(rows, x0, x1):
    return [r[x0:x1] for r in rows]


def overlay(base, art, x0, y0, only_empty=True):
    rows = [list(r) for r in base]
    for y, r in enumerate(art):
        for x, ch in enumerate(r):
            if ch == ".":
                continue
            Y, X = y0 + y, x0 + x
            if 0 <= Y < len(rows) and 0 <= X < len(rows[0]):
                if not only_empty or rows[Y][X] == ".":
                    rows[Y][X] = ch
    return ["".join(r) for r in rows]


# ------------------------------------------------------------------ tiles
def tiles():
    themes = {
        "overworld": AW.BLOCK_PAL,
        "underground": AW.BLOCK_PAL_UNDER,
        "castle": AW.BLOCK_PAL_CASTLE,
    }
    for theme, pal in themes.items():
        d = f"tiles/{theme}/"
        ground = AW.BRICK if theme == "castle" else AW.GROUND  # castle floor is grey brickwork
        save(render(ground, pal), d + "ground.png")
        save(render(AW.BRICK, pal), d + "brick.png")
        save(render(AW.USED, pal if theme != "castle" else AW.BLOCK_PAL), d + "used.png")
        save(render(AW.HARD, pal), d + "block.png")
        coin_pals = AW.COIN_UNDER_PALS if theme == "underground" else AW.COIN_PALS
        save(strip([render(AW.COIN, p) for p in coin_pals]), d + "coin.png")
    d = "tiles/overworld/"
    save(strip([render(AW.QBLOCK, p) for p in AW.QBLOCK_PALS]), d + "question.png")
    pp = AW.PIPE_PAL
    save(render(crop_cols(AW.PIPE_TOP, 0, 16), pp), d + "pipe_tl.png")
    save(render(crop_cols(AW.PIPE_TOP, 16, 32), pp), d + "pipe_tr.png")
    save(render(crop_cols(AW.PIPE_BODY, 0, 16), pp), d + "pipe_l.png")
    save(render(crop_cols(AW.PIPE_BODY, 16, 32), pp), d + "pipe_r.png")
    mouth = transpose(AW.PIPE_TOP)        # 16x32, opening faces left
    body = transpose(AW.PIPE_BODY)        # 16x32
    save(render(mouth[:16], pp), d + "pipe_side_mouth_t.png")
    save(render(mouth[16:], pp), d + "pipe_side_mouth_b.png")
    save(render(body[:16], pp), d + "pipe_side_body_t.png")
    save(render(body[16:], pp), d + "pipe_side_body_b.png")
    # junction: left half of the vertical pipe body, opened on the left where
    # the side pipe enters (rows 2..29 of the 32-px-tall pair)
    vert = crop_cols(AW.PIPE_BODY, 0, 16) * 2
    join = []
    for y in range(32):
        if 2 <= y <= 29:
            join.append(body[y][:3] + vert[y][3:])
        else:
            join.append(vert[y])
    save(render(join[:16], pp), d + "pipe_side_join_t.png")
    save(render(join[16:], pp), d + "pipe_side_join_b.png")
    save(render(A1.TREETOP_L, A1.TREE_PAL), d + "treetop_l.png")
    save(render(A1.TREETOP_M, A1.TREE_PAL), d + "treetop_m.png")
    save(render(A1.TREETOP_R, A1.TREE_PAL), d + "treetop_r.png")
    save(render(A1.TRUNK, A1.TREE_PAL), d + "trunk.png")
    save(render(AW.POLE_BALL, AW.FLAG_PAL), d + "flag_ball.png")
    save(render(AW.POLE, AW.FLAG_PAL), d + "flag_pole.png")
    # castle-only tiles, also under overworld/ because the loader probes every name there first
    for d in ("tiles/castle/", "tiles/overworld/"):
        castle_only(d)


def castle_only(d):
    save(render(A1.BRIDGE, A1.BRIDGE_PAL), d + "bridge.png")
    save(render(A1.CHAIN, A1.CHAIN_PAL), d + "chain.png")
    save(strip([render(A1.AXE, p) for p in A1.AXE_PALS]), d + "axe.png")
    save(render(A1.LAVA_TOP, A1.LAVA_PAL), d + "lava_top.png")
    save(render(A1.LAVA, A1.LAVA_PAL), d + "lava.png")


