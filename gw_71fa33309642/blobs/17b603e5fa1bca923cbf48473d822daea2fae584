        check("piranha " + n, a, 16, 24)
    save(strip([render(A1.PIRANHA[n], A1.PIRANHA_PAL) for n in ("open", "closed")]), "sprites/piranha.png")
    for i, f in enumerate(bowser.FRAMES):
        check(f"bowser{i}", f, 32, 32)
