        im.alpha_composite(frame_of("ui/coin_icon.png", 0, 8), (88, 24))
        text(im, "x07", 96, 24)
        text(im, world, 152, 24)
        text(im, "354", 208, 24)

    # 1-1 start
    im = Image.new("RGBA", (256, 240), (92, 148, 252, 255))
    a = im.alpha_composite
