# ------------------------------------------------------------------ scenery
def scenery():
    cloud_pal = {"K": 0x0F, "F": 0x30, "S": 0x21}
    bush_pal = {"K": 0x0F, "F": 0x29, "S": 0x1A}
    for n in (1, 2, 3):
        rows, w = puff_shape(n, 24, flat_bottom=False)
        save(render(rows, cloud_pal), f"scenery/cloud_{n}.png")
        rows, w = puff_shape(n, 16, flat_bottom=True)
        last = rows[-1]
        rows[-1] = "".join("F" if c == "K" and 0 < i < w - 1 and last[i - 1] != "." and last[i + 1] != "." else c
                           for i, c in enumerate(last))
        save(render(rows, bush_pal), f"scenery/bush_{n}.png")
    hill_pal = {"K": 0x0F, "F": 0x1A}
    save(render(hill_shape(5, 35), hill_pal), "scenery/hill_large.png")
    save(render(hill_shape(3, 19), hill_pal), "scenery/hill_small.png")
    save(render(AW.FLAG, AW.FLAG_PAL), "scenery/flag.png")
    save(render(AW.CASTLE_FLAG, AW.CASTLE_FLAG_PAL), "scenery/castle_flag.png")
    # end-of-level castle, 5x5 tiles: 3-wide tower on a 5-wide base
    castle = Image.new("RGBA", (80, 80), (0, 0, 0, 0))
    bp = AW.BLOCK_PAL

    def put(art, tx, ty):
        castle.alpha_composite(render(art, bp), (tx * 16, ty * 16))
    for tx in (1, 2, 3):
        put(AW.CASTLE_TOP, tx, 0)
    put(AW.CASTLE_WINDOW, 1, 1)
    put(AW.CASTLE_WALL, 2, 1)
    put(AW.CASTLE_WINDOW, 3, 1)
    for tx in range(5):
        put(AW.CASTLE_TOP_SOLID if tx in (1, 2, 3) else AW.CASTLE_TOP, tx, 2)
        put(AW.CASTLE_WALL, tx, 3)
        put(AW.CASTLE_WALL, tx, 4)
    put(AW.CASTLE_ARCH, 2, 3)
    put(AW.CASTLE_DOOR, 2, 4)
    save(castle, "scenery/castle_small.png")
    # large castle ending 1-3, 5x11 tiles: three tiers (tower, keep, gatehouse with a 2-tile doorway)
    castle = Image.new("RGBA", (80, 176), (0, 0, 0, 0))
    for tx in (1, 2, 3):
        put(AW.CASTLE_TOP, tx, 0)
    put(AW.CASTLE_WINDOW, 1, 1)
    put(AW.CASTLE_WALL, 2, 1)
    put(AW.CASTLE_WINDOW, 3, 1)
    for tx in range(5):
        put(AW.CASTLE_TOP_SOLID if tx in (1, 2, 3) else AW.CASTLE_TOP, tx, 2)
        for ty in range(3, 11):
            put(AW.CASTLE_WALL, tx, ty)
        put(AW.CASTLE_TOP_SOLID, tx, 6)
    for tx in (0, 2, 4):
        put(AW.CASTLE_WINDOW, tx, 4)
    for tx in (1, 3):
        put(AW.CASTLE_WINDOW, tx, 8)
    put(AW.CASTLE_ARCH, 2, 9)
    put(AW.CASTLE_DOOR, 2, 10)
    save(castle, "scenery/castle_big.png")


# ------------------------------------------------------------------ sprites
def mario_strips():
    def big_frames(pal, real_throw):
        b = {n: bottom_align(a) if not n.startswith("climb") else a for n, a in AM.BIG.items()}
        for n, a in b.items():
            check("big " + n, a, 16, 32)
        throw = AM.BIG_HEAD + A1.MARIO_THROW_BODY + AM.BIG["stand"][22:]
        check("throw", throw, 16, 32)
        swim = [bottom_align(AM.BIG_HEAD + A2.BIG_SWIM_BODY[n]) for n in ("swim1", "swim2", "swim3")]
        for i, a in enumerate(swim):
            check(f"big swim{i}", a, 16, 32)
        order = [b["stand"], b["walk1"], b["walk2"], b["walk3"], b["skid"], b["jump"], b["crouch"],
                 b["climb1"], b["climb2"]] + swim + [throw if real_throw else b["stand"]]
        return [render(a, pal) for a in order]

    s = AM.SMALL
    for n, a in s.items():
        check("small " + n, a, 16, 16)
    small = [s["stand"], s["walk1"], s["walk2"], s["walk3"], s["skid"], s["jump"], s["death"],
             s["climb1"], s["climb2"]] + [A2.SMALL_SWIM[n] for n in ("swim1", "swim2", "swim3")] + [s["stand"]]
    for n, a in A2.SMALL_SWIM.items():
        check("small " + n, a, 16, 16)
    save(strip([render(a, AM.NORMAL) for a in small]), "sprites/mario_small.png")
    save(strip(big_frames(AM.NORMAL, False)), "sprites/mario_big.png")
    save(strip(big_frames(AM.FIRE, True)), "sprites/mario_fire.png")


