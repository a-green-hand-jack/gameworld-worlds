# ------------------------------------------------------------------ ui
FONT_ORDER = list("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-x!") + ["(c)", "."]


def ui():
    glyphs = []
    for ch in FONT_ORDER:
        g = AT.GLYPHS[ch]
        check("glyph " + ch, g, 7, 7)
        glyphs.append(render([r + "." for r in g] + ["........"], {"#": 0x30}))
    font = strip(glyphs)
    assert font.size == (328, 8)
    save(font, "ui/font.png")
    save(strip([render(AT.HUD_COIN, p) for p in AW.COIN_PALS]), "ui/coin_icon.png")
    cursor = ["..RRRR..", ".RWWRRR.", "RWWRRWWR", "RRRRRWWR", ".CCCCCC.", "..CKKC..", "..CCCC..", "........"]
    save(render(cursor, {"R": 0x16, "W": 0x37, "C": 0x37, "K": 0x0F}), "ui/cursor.png")
    save(title_logo(), "ui/title_logo.png")


def title_logo():
    """Logo plate: SUPER / MARIO BROS. in bold 2x type with drop shadow."""
    W, H = 176, 88
    plate = Image.new("RGBA", (W, H), rgb(0x17))
    px = plate.load()
    light, black = rgb(0x36), rgb(0x0F)
    for x in range(W):
        for y in range(H):
            if x < 2 or y < 2:
                px[x, y] = light
            elif x >= W - 2 or y >= H - 2:
                px[x, y] = black
    for cx, cy in ((5, 5), (W - 7, 5), (5, H - 7), (W - 7, H - 7)):
        for dx in range(2):
            for dy in range(2):
                px[cx + dx, cy + dy] = black

    def text(s, y0, scale, fill, shadow):
        adv = 7 * scale + 1
        x0 = (W - (len(s) * adv - 1)) // 2
        for off, col in (((shadow, shadow), black), ((0, 0), fill)):
            if off == (0, 0) or shadow:
                x = x0
                for ch in s:
                    for gy, row in enumerate(AT.GLYPHS[ch]):
                        for gx, c in enumerate(row):
                            if c == "#":
                                for sx in range(scale):
                                    for sy in range(scale):
                                        X = x + gx * scale + sx + off[0]
                                        Y = y0 + gy * scale + sy + off[1]
                                        if 0 <= X < W and 0 <= Y < H:
                                            px[X, Y] = col
                    x += adv

    text("SUPER", 10, 2, light, 2)
    text("MARIO BROS.", 36, 2, light, 2)
    text("A FAN REMAKE", 68, 1, rgb(0x30), 0)
    return plate


# ------------------------------------------------------------------ review
def frame_of(rel, n=0, w=None):
    im = Image.open(os.path.join(OUT, rel)).convert("RGBA")
    if w is None:
        return im
    return im.crop((n * w, 0, n * w + w, im.size[1]))


def mock_scenes():
    os.makedirs(CHECK, exist_ok=True)
    T = lambda theme, name: frame_of(f"tiles/{theme}/{name}.png") if os.path.exists(
        os.path.join(OUT, f"tiles/{theme}/{name}.png")) else frame_of(f"tiles/overworld/{name}.png")
    font = frame_of("ui/font.png")

    def text(im, s, x, y):
        for ch in s:
            if ch != " ":
                i = FONT_ORDER.index(ch)
                im.alpha_composite(font.crop((i * 8, 0, i * 8 + 8, 8)), (x, y))
            x += 8

    def hud(im, world="1-1"):
        text(im, "MARIO", 24, 16)
        text(im, "WORLD", 144, 16)
        text(im, "TIME", 200, 16)
