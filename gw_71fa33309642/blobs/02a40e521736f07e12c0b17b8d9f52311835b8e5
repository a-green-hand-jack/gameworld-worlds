#!/usr/bin/env python3
"""Review screens for World 2, built only from the delivered files in assets/.
Run after export.py:  python3 tools/gfx/mock_w2.py  -> tools/gfx/check/scene_2-*_x3.png"""
import os
from PIL import Image

HERE = os.path.dirname(os.path.abspath(__file__))
A = os.path.join(HERE, "..", "..", "assets")
CHECK = os.path.join(HERE, "check")
FONT = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-x!c."


def img(rel, n=None, w=None):
    im = Image.open(os.path.join(A, rel)).convert("RGBA")
    return im if n is None else im.crop((n * w, 0, n * w + w, im.size[1]))


def T(theme, name, n=None):
    p = f"tiles/{theme}/{name}.png"
    if not os.path.exists(os.path.join(A, p)):
        p = f"tiles/overworld/{name}.png"
    return img(p, n, 16) if n is not None else img(p)


def text(im, s, x, y):
    font = img("ui/font.png")
    for ch in s:
        if ch != " ":
            i = FONT.index(ch)
            im.alpha_composite(font.crop((i * 8, 0, i * 8 + 8, 8)), (x, y))
        x += 8


def hud(im, world):
    text(im, "MARIO", 24, 16); text(im, "WORLD", 144, 16); text(im, "TIME", 200, 16)
    text(im, "004350", 24, 24); im.alpha_composite(img("ui/coin_icon.png", 0, 8), (88, 24))
    text(im, "x21", 96, 24); text(im, world, 152, 24); text(im, "287", 208, 24)


def save(im, name):
    os.makedirs(CHECK, exist_ok=True)
    im.resize((768, 720), Image.NEAREST).save(os.path.join(CHECK, name))


SKY = (92, 148, 252, 255)

# 2-1 overworld: trees, fences, springboard, beanstalk rising from a brick
im = Image.new("RGBA", (256, 240), SKY); a = im.alpha_composite
