a(img("scenery/tree_large.png"), (16, 160)); a(img("scenery/tree_small.png"), (32, 176))
a(img("scenery/tree_small.png"), (176, 176))
for x in (48, 64, 80, 192, 208):
    a(img("scenery/fence.png"), (x, 192))
for x in range(0, 256, 16):
    a(T("overworld", "ground"), (x, 208)); a(T("overworld", "ground"), (x, 224))
for x in (96, 112, 128):
    a(T("overworld", "brick"), (x, 144))
a(T("overworld", "used"), (112, 144))
a(img("sprites/vine.png", 0, 16), (112, 64))
for y in range(80, 144, 16):
    a(img("sprites/vine.png", 1, 16), (112, y))
a(img("sprites/mario_big.png", 7, 16), (106, 80))
for i, x in enumerate((152, 176, 200)):
    a(img("sprites/jumpspring.png", i, 16), (x, 176))
a(img("sprites/parakoopa_green.png", 0, 16), (232, 120))
a(img("sprites/piranha.png", 0, 16), (60, 100))
hud(im, "2-1"); save(im, "scene_2-1_x3.png")

