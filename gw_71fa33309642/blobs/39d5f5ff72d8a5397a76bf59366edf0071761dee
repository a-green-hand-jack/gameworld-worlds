def section_w24():
    g = new('2-4'); clear(g); god(g)
    g.js("SMB.game.area.spawned.fill(false)"); g.js("SMB.game.enemies = []")
    check('W24.time-300', abs(S(g)['time'] - 300) <= 2, S(g)['time'])
    fbs = g.js("SMB.game.area.enemyDefs.filter(e => e.type === 'firebar').map(e => ({x: e.x, y: e.y, ccw: e.ccw, long: e.long}))")
    print('   firebars', fbs)
    # firebar geometry and rotation
    tp(g, 49 * 16, 12 * 16, 40 * 16)
    g.step(20)
    fb = g.js("SMB.game.enemies.filter(e => e.type === 'firebar').map(e => ({x: e.x, y: e.y, keys: Object.keys(e)}))")
    check('W24.firebars-spawn-near-mario', len(fb) >= 1, fb[:2])
    if fb: print('   firebar keys', fb[0]['keys'])
    g.close()

    # podoboos jump out of the lava and come back; touching hurts
    g = new('2-4'); clear(g); god(g)
    g.js("SMB.game.area.spawned.fill(false)")
    tp(g, 14 * 16, 10 * 16, 4 * 16)
    ys = []
    for i in range(400):
        g.step(1); g.js("SMB.game.player.invuln = 99999999")
        y = g.js("(() => { const e = SMB.game.enemies.find(e => e.type === 'podoboo'); return e ? e.y : null; })()")
        if y is not None: ys.append(y)
    check('W24.podoboo-leaps-and-falls-back', ys and min(ys) < 11 * 16 and max(ys) >= 12 * 16 - 4, (min(ys), max(ys)) if ys else None)
    shot(g, 'w24_podoboo')
    # podoboo hurts
    g.js("(() => { const G = SMB.game, p = G.player, e = G.enemies.find(e => e.type === 'podoboo'); p.invuln = 0; p.power = 0; p.x = e.x; p.y = e.y; })()")
    g.step(3)
    check('W24.podoboo-touch-hurts-small-mario', S(g)['dead'] or g.js("SMB.game.state") == 'dying', S(g))
    g.close()

    # firebar touch hurts, big Mario shrinks
    g = new('2-4'); clear(g)
    g.js("SMB.game.area.spawned.fill(false)")
    g.js("SMB.game.player.power = 1")
    tp(g, 49 * 16, 8 * 16, 40 * 16); g.step(10)
    hurt = False
    for i in range(300):
        g.js("(() => { const G = SMB.game, p = G.player, f = G.enemies.find(e => e.type === 'firebar'); if (f) { p.x = f.cx - 6; p.y = f.cy - 8; } })()")
        g.step(1)
        if S(g)['power'] == 0 or S(g)['dead']: hurt = True; break
    check('W24.firebar-hurts-and-shrinks-big-mario', hurt, S(g))
    g.close()

    # Fake Bowser: fireballs reveal a koopa troopa
    g = new('2-4'); clear(g); god(g)
    g.js("SMB.game.area.spawned.fill(false)")
    g.js("SMB.game.player.power = 2")
    tp(g, 126 * 16, 10 * 16, 120 * 16); g.js("SMB.game.player.y = 10*16 - SMB.game.player.h"); g.step(60)
    bw = enemies(g, "e.type === 'bowser'")
    check('W24.bowser-on-bridge-spawned', len(bw) == 1, bw)
    shot(g, 'w24_bowser')
    flames = 0; hits = 0
    for i in range(900):
        g.js("(() => { const G = SMB.game, p = G.player, b = G.enemies.find(e => e.type === 'bowser'); p.invuln = 99999999; if (b && !b.dying) { p.x = Math.max(b.x - 90, 129 * 16); p.y = 10 * 16 - p.h; p.vx = 0; p.vy = 0; p.facing = 1; G.camX = Math.max(0, p.x - 100); } })()")
        if i % 12 == 0: g.press('B')
        else: g.step(1)
        flames = max(flames, g.js("SMB.game.enemies.filter(e => e.type === 'bowserfire').length"))
        if not g.js("SMB.game.enemies.some(e => e.type === 'bowser' && !e.dying)"): break
    g.step(6); shot(g, 'w24_bowser_dead')
    ft = g.js("(() => { const b = SMB.game.enemies.find(e => e.type === 'bowser'); return b ? [b.fakeType, b.dying] : null; })()")
    after = enemies(g)
    print('   fireballs frames', i, 'max bowser flames', flames, 'after', after)
    check('W24.bowser-breathes-fire', flames >= 1, flames)
    check('W24.fire-defeats-fake-bowser-reveals-koopa', i < 899 and ft == ['koopa', True], (ft, after))
    g.close()

    # Bowser stomped does not hurt it; touching it hurts Mario
    g = new('2-4'); clear(g)
    g.js("SMB.game.area.spawned.fill(false)")
    tp(g, 126 * 16, 10 * 16, 120 * 16); g.js("SMB.game.player.y = 10*16 - SMB.game.player.h"); g.step(60)
    g.js("(() => { const G = SMB.game, p = G.player, b = G.enemies.find(e => e.type === 'bowser'); p.invuln = 0; p.x = b.x + 2; p.y = b.y - p.h - 4; p.vy = 4; })()")
    g.step(4)
    check('W24.stomping-bowser-does-not-kill-it', g.js("SMB.game.enemies.some(e => e.type === 'bowser' && !e.dying)"), enemies(g))
    g.close()

    # Axe -> bridge collapse -> Toad text (check message by screenshot) -> end
    g = new('2-4'); clear(g); god(g)
    g.js("SMB.game.area.spawned.fill(false)"); g.js("SMB.game.enemies = []")
    tp(g, 141 * 16 + 2, 9 * 16, 134 * 16); g.js("SMB.game.player.y = 9*16 - SMB.game.player.h")
    n = until(g, "SMB.game.state === 'axe'", 20)
    check('W24.axe-triggers-ending', n is not None, S(g))
    b0 = g.js("(() => { const a = SMB.game.area; let n = 0; for (let x = 120; x < 142; x++) if (a.get(x, 10) === 24) n++; return n; })()")
    g.step(240)
    b1 = g.js("(() => { const a = SMB.game.area; let n = 0; for (let x = 120; x < 142; x++) if (a.get(x, 10) === 24) n++; return n; })()")
    check('W24.bridge-collapses-after-axe', b0 > 0 and b1 == 0, (b0, b1))
    until(g, "SMB.game.axeState && SMB.game.axeState.phase === 'message'", 2500); g.step(120)
    shot(g, 'w24_toad')
    g.close()

    # top-to-bottom traversal of the castle by the search bot is done separately (qa/search_bot.py 2-4)

