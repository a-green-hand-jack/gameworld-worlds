import numpy as np, wave
from PIL import Image, ImageDraw, ImageFont
S=32
P=dict(bg=(18,24,38),bg2=(26,35,55),head=(120,230,110),body=(70,185,85),dark=(40,120,60),eye=(255,255,255),pupil=(15,15,25),food=(235,64,72),foodhi=(255,170,170),stem=(110,75,40),leaf=(90,200,90),text=(235,245,235))
def new(w=S,h=S): return Image.new("RGBA",(w,h),(0,0,0,0))
def body():
    im=new(); d=ImageDraw.Draw(im)
    d.rounded_rectangle([2,2,29,29],6,fill=P['dark']); d.rounded_rectangle([3,3,28,26],6,fill=P['body'])
    d.rectangle([8,8,23,12],fill=(95,210,105)); return im
def head_right():
    im=new(); d=ImageDraw.Draw(im)
    d.rounded_rectangle([2,2,30,29],9,fill=P['dark']); d.rounded_rectangle([2,2,29,26],9,fill=P['head'])
    for y in (7,19):
        d.ellipse([18,y,25,y+7],fill=P['eye']); d.ellipse([22,y+2,25,y+5],fill=P['pupil'])
    d.rectangle([29,14,31,17],fill=(230,60,70)); return im
def food():
    im=new(); d=ImageDraw.Draw(im)
    d.ellipse([5,8,27,29],fill=P['food']); d.ellipse([9,11,14,16],fill=P['foodhi'])
    d.rectangle([15,3,17,9],fill=P['stem']); d.polygon([(17,5),(24,2),(23,8)],fill=P['leaf']); return im
def tile(a):
    im=Image.new("RGBA",(S,S),P['bg' if a else 'bg2']); d=ImageDraw.Draw(im)
    d.rectangle([0,0,S-1,S-1],outline=(31,42,66)); return im
def font(sz):
    for p in ["/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"]:
        try: return ImageFont.truetype(p,sz)
        except: pass
    return ImageFont.load_default()
def logo():
    W,H=480,140; im=new(W,H); d=ImageDraw.Draw(im); f=font(84)
    d.text((W//2,H//2+4),"SNAKE",font=f,fill=P['dark'],anchor="mm")
    d.text((W//2,H//2-2),"SNAKE",font=f,fill=P['head'],anchor="mm")
    for i in range(6): im.paste(body(),(W//2-96+i*32,H-30)) if False else None
    return im
def panel():
    W,H=360,200; im=new(W,H); d=ImageDraw.Draw(im)
    d.rounded_rectangle([0,0,W-1,H-1],14,fill=(10,14,24,235),outline=P['food'],width=4)
    d.text((W//2,48),"GAME OVER",font=font(40),fill=P['food'],anchor="mm"); return im
def save(im,n): im.save(f"assets/img/{n}.png")
h=head_right(); save(h,"head_right"); save(h.transpose(Image.FLIP_LEFT_RIGHT),"head_left")
save(h.rotate(90),"head_up"); save(h.rotate(-90),"head_down")
save(body(),"body"); save(food(),"food")
bt=Image.new("RGBA",(S*2,S)); bt.paste(tile(1),(0,0)); bt.paste(tile(0),(S,0)); save(bt,"bg_tile_pair")
save(tile(1),"bg_tile"); save(logo(),"title_logo"); save(panel(),"gameover_panel")
SR=44100
def wr(n,x):
    x=x/np.max(np.abs(x))*0.7; fade=int(SR*0.01); x[:fade]*=np.linspace(0,1,fade); x[-fade:]*=np.linspace(1,0,fade)
    w=wave.open(f"assets/audio/{n}.wav","wb"); w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR); w.writeframes((x*32767).astype('<i2').tobytes()); w.close()
def tone(freqs,dur,sq=True,decay=6):
    out=[]
    for f in freqs:
        t=np.arange(int(SR*dur))/SR; s=np.sign(np.sin(2*np.pi*f*t)) if sq else np.sin(2*np.pi*f*t)
        out.append(s*np.exp(-decay*t/dur)); 
    return np.concatenate(out)
wr("eat",tone([660,990],0.07)); wr("start",tone([392,523,659,784],0.09,decay=3))
t=np.arange(int(SR*0.6))/SR; f=440*np.exp(-2.2*t); wr("gameover",np.sign(np.sin(2*np.pi*np.cumsum(f)/SR))*np.exp(-3*t))
