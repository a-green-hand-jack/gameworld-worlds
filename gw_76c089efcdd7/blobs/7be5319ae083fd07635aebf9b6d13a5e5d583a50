import base64,hashlib,json,os,pathlib,subprocess,urllib.request
p=pathlib.Path('/hutian/qa-build-1/sound/beep.wav')
body={'model':'gemini-3.8-flash','input':[{'type':'text','text':'Describe what you hear in this audio and when. Give the onset and end of any tone, whether its loudness changes, and any silence, using timestamps with fractional seconds where possible.'},{'type':'audio','mime_type':'audio/wav','data':base64.b64encode(p.read_bytes()).decode()}]}
pathlib.Path('qa-evidence/request.json').write_text(json.dumps(body,indent=2))
url=subprocess.check_output(['ht-resource','url','audio-understanding'],text=True).strip()
req=urllib.request.Request(url+'/v1beta/interactions',json.dumps(body).encode(),{'Content-Type':'application/json','x-goog-api-key':os.environ['HT_RESOURCE_TOKEN']})
with urllib.request.urlopen(req,timeout=120) as r:
 raw=r.read()
pathlib.Path('qa-evidence/response.json').write_bytes(raw)
print(raw.decode())
print('WAV sha256:',hashlib.sha256(p.read_bytes()).hexdigest())
