import base64, json, os, subprocess, sys, urllib.request
url = subprocess.check_output(['ht-resource', 'url', 'audio-understanding'], text=True).strip()
q = sys.argv[2]
body = {'model': 'gemini-3.8-flash', 'input': [{'type': 'text', 'text': q}, {'type': 'audio', 'mime_type': 'audio/wav', 'data': base64.b64encode(open(sys.argv[1], 'rb').read()).decode()}]}
json.dump({k:(v if k!='input' else [body['input'][0], {'type':'audio','mime_type':'audio/wav','data':'<base64 of sound/hit.wav, %d bytes>'%os.path.getsize(sys.argv[1])}]) for k,v in body.items()}, open(sys.argv[3]+'.request.json','w'), indent=2)
request = urllib.request.Request(url + '/v1beta/interactions', json.dumps(body).encode(), {'Content-Type': 'application/json', 'x-goog-api-key': os.environ['HT_RESOURCE_TOKEN']})
answer = json.load(urllib.request.urlopen(request, timeout=900))
json.dump(answer, open(sys.argv[3]+'.answer.json','w'), indent=2)
print(''.join(part.get('text', '') for step in answer.get('steps', []) if step.get('type') == 'model_output' for part in step.get('content', []) if part.get('type') == 'text'))
