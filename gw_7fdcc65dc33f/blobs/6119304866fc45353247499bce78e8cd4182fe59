* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  font-family: system-ui, sans-serif;
  background: #7cc46a;
  color: #2b1d0e;
  display: flex; align-items: center; justify-content: center;
  user-select: none;
}
#app { width: min(96vw, 520px); text-align: center; }
.screen { display: none; }
.screen.active { display: block; }
h1 { font-size: 2.6rem; margin: 0 0 .5em; }
p { font-size: 1.15rem; line-height: 1.5; }
button {
  font-size: 1.3rem; padding: .6em 1.6em; border: 0; border-radius: 999px;
  background: #8a5a2b; color: #fff; cursor: pointer;
}
button:hover { background: #6e4520; }
#hud {
  display: flex; justify-content: space-between;
  font-size: 1.4rem; font-weight: bold; margin-bottom: 12px;
}
#grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
}
.hole {
  position: relative; aspect-ratio: 1; overflow: hidden;
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 70%, #3a2412 0 45%, #5c3a1c 46% 60%, transparent 61%);
  cursor: pointer;
}
.mole {
  position: absolute; left: 22%; width: 56%; height: 62%;
  bottom: -70%;
  transition: bottom 90ms ease-out;
  pointer-events: none;
  background-size: contain; background-repeat: no-repeat; background-position: center bottom;
}
.mole.css-mole {
  border-radius: 50% 50% 40% 40%;
  background: #8b5e3c;
  box-shadow: inset 0 -8px 0 #6f4a2e;
}
.mole.css-mole::before, .mole.css-mole::after {
  content: ""; position: absolute; top: 28%; width: 12%; height: 12%;
  background: #111; border-radius: 50%;
}
.mole.css-mole::before { left: 28%; }
.mole.css-mole::after { right: 28%; }
.mole.css-mole .nose {
  position: absolute; left: 40%; top: 44%; width: 20%; height: 14%;
  background: #e78a9c; border-radius: 50%;
}
.hole.up .mole { bottom: 8%; }
.hole.hit .mole { filter: brightness(1.6); bottom: -10%; transition: bottom 150ms ease-in; }
