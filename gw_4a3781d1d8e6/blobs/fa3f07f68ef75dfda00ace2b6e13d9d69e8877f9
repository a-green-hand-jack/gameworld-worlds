"""QA checks of the Snake delivery against brief R1-R10 (independent of game-developer's tests/check.py).

Usage: python3 tests/qa_check.py DELIVERY_DIR OUT_DIR
Writes OUT_DIR/results.json and screenshots; exit 1 if any check fails.
"""
import functools, http.server, json, os, sys, threading, time
from playwright.sync_api import sync_playwright

root = os.path.abspath(sys.argv[1]); out = os.path.abspath(sys.argv[2]); os.makedirs(out, exist_ok=True)
class Q(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a): pass
srv = http.server.ThreadingHTTPServer(('127.0.0.1', 0), functools.partial(Q, directory=root))
threading.Thread(target=srv.serve_forever, daemon=True).start()
BASE = 'http://127.0.0.1:%d/index.html' % srv.server_address[1]
results = []
def check(req, name, ok, detail=''):
    results.append({'req': req, 'check': name, 'ok': bool(ok), 'detail': str(detail)})
    print(('PASS' if ok else 'FAIL'), req, name, detail if not ok else '')

KEY = {'up': 'ArrowUp', 'down': 'ArrowDown', 'left': 'ArrowLeft', 'right': 'ArrowRight'}
def st(p): return p.evaluate('() => __snake.state')
def gm(p): return p.evaluate('() => JSON.parse(JSON.stringify(__snake.game))')
def head(p): return gm(p)['snake'][0]
def score_dom(p): return p.inner_text('#score')
def shot(p, n): p.screenshot(path=os.path.join(out, n + '.png'))

with sync_playwright() as pw:
    br = pw.chromium.launch()
    def newpage(url_suffix='?manual=1&seed=1', viewport=(1280, 720)):
        ctx = br.new_context(viewport={'width': viewport[0], 'height': viewport[1]})
        p = ctx.new_page(); p.errors = []; p.requests = []; p.failed = []
        p.on('console', lambda m: p.errors.append(m.type + ': ' + m.text) if m.type in ('error', 'warning') else None)
        p.on('pageerror', lambda e: p.errors.append('pageerror: ' + str(e)))
        p.on('request', lambda r: p.requests.append(r.url))
        p.on('response', lambda r: p.failed.append(r.url) if r.status >= 400 else None)
        p.goto(BASE + url_suffix); p.wait_for_timeout(500)
        return p
    def start(p, key='Enter'):
        p.keyboard.press(key); p.wait_for_timeout(50)
    def tick(p, n=1):
        for _ in range(n): p.evaluate('() => __snake.tick()')
    def setg(p, snake, dir_, food=None):
        p.evaluate('([s,d,f]) => {const g=__snake.game; g.snake=s; g.dir=d; g.queue=[]; if(f) g.food=f; __snake.draw();}', [snake, dir_, food])
    def line(x, y, n, dx, dy): return [{'x': x - dx * i, 'y': y - dy * i} for i in range(n)]

    # ---------- R1 / R7 title ----------
    p = newpage()
    check('R7', 'title shown on load', st(p) == 'title' and p.is_visible('#title-screen'))
    txt = p.inner_text('#title-screen').lower()
    alt = p.get_attribute('#title-logo', 'alt') or ''
    check('R7', 'title names game, says how to start and control', ('snake' in txt or 'snake' in alt.lower()) and 'arrow' in txt and ('start' in txt or 'enter' in txt), txt)
    check('R7', 'game not playing before start (no game object)', p.evaluate('() => __snake.game') is None)
    shot(p, '01-title')
    for k in ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'a', 'w']:
        p.keyboard.press(k)
    p.wait_for_timeout(300)
    check('R7', 'arrows/other keys on title do not start play', st(p) == 'title')
    check('R7', 'score HUD hidden on title', not p.is_visible('#hud'))
    check('R1', 'no console errors/warnings on load', not p.errors, p.errors)
    check('R1', 'no failed (>=400) responses', not p.failed, p.failed)
    ext = [u for u in p.requests if not u.startswith('http://127.0.0.1')]
    check('R1', 'no network requests outside the local server (offline play)', not ext, ext)
    a = p.evaluate('() => __snake.assets()')
    check('R1', 'all assets loaded', len(a['images']) == 5 and len(a['sounds']) == 3 and a['logo'] and a['font'], a)
    p.context.close()

    # file:// load
