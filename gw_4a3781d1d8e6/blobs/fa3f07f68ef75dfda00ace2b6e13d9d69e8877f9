            break
        setg(p, g['snake'], d, {'x': h['x'] + dx, 'y': h['y'] + dy}); l0, s0 = len(g['snake']), g['score']; tick(p); g = gm(p)
        ok &= (len(g['snake']) == l0 + 1 and g['score'] == s0 + 1 and score_dom(p) == str(g['score']))
    check('R4', 'consecutive foods each exactly +1 length/+1 score', ok)
    p.context.close()
    # food never on snake: autopilot many games through the real page logic
    p = newpage('?manual=1&seed=7'); start(p)
    bad = p.evaluate('''() => {
      const L = window.SnakeLogic; let viol = 0, eaten = 0, games = 0, notBoard = 0;
      for (let seed = 1; seed <= 150; seed++) {
        const g = L.createGame({cols: 20, rows: 20, rng: L.makeRng(seed)});
        for (let t = 0; t < 3000 && !g.over; t++) {
          // greedy toward food avoiding immediate death
          const h = g.snake[0], f = g.food; const opts = ['up','down','left','right'].filter(d => d !== L.OPPOSITE[g.dir]);
          const occ = new Set(g.snake.slice(0,-1).map(s => s.x+','+s.y));
          const sc = d => {const v=L.DIRS[d]; const nx=h.x+v.x, ny=h.y+v.y; if(nx<0||ny<0||nx>=20||ny>=20||occ.has(nx+','+ny)) return 1e9; return Math.abs(nx-f.x)+Math.abs(ny-f.y)+Math.random()*0.1;};
          opts.sort((a,b)=>sc(a)-sc(b)); L.turn(g, opts[0]);
          const before = g.score, len = g.snake.length; const r = L.step(g);
          if (g.score !== before) { eaten++; if (g.score !== before + 1 || g.snake.length !== len + 1) viol++; }
          else if (!g.over && g.snake.length !== len) viol++;
          if (g.food) { if (g.snake.some(s => s.x === g.food.x && s.y === g.food.y)) viol++; if (g.food.x<0||g.food.y<0||g.food.x>=20||g.food.y>=20) notBoard++; }
          const cells = new Set(g.snake.map(s => s.x+','+s.y)); if (cells.size !== g.snake.length && !g.over) viol++;
        }
        games++;
      }
      return {viol, eaten, games, notBoard};
    }''')
    check('R4', 'autopilot, 150 games: food never on snake/off board; every eat is +1/+1 (eaten=%d)' % bad['eaten'], bad['viol'] == 0 and bad['notBoard'] == 0 and bad['eaten'] > 300, bad)
    # win by filling board
    w = p.evaluate('''() => { const L = window.SnakeLogic; const g = L.createGame({cols:3, rows:2, length:3, rng: L.makeRng(1)});
      // snake fills row y=1 (x=1,0,-1)? length 3 on 3 cols starts at hx=1 -> x 1,0,-1 invalid; use cols 4
      return null; }''')
    p.context.close()

    # ---------- R5 walls ----------
    walls = {
        'right': (lambda: None, [], 'right'),
        'up': (None, ['ArrowUp'], 'up'),
        'down': (None, ['ArrowDown'], 'down'),
        'left': (None, ['ArrowUp', 'ArrowLeft'], 'left'),  # go up one, then left (can't reverse directly)
    }
    for name, (_, keys, d) in walls.items():
        p = newpage(); start(p)
        for k in keys: p.keyboard.press(k); tick(p)
        steps = 0
        while st(p) == 'playing' and steps < 40:
            tick(p); steps += 1
        g = gm(p); h = g['snake'][0]
        inside = 0 <= h['x'] < 20 and 0 <= h['y'] < 20
        check('R5', 'wall %s ends the game (no wrap)' % name, st(p) == 'gameover' and inside, (st(p), h, steps))
