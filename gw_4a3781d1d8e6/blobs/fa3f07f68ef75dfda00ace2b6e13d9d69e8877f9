    check('R8', 'HUD score shows 3 after 3 foods', score_dom(p) == '3', score_dom(p))
    while st(p) == 'playing': tick(p)
    check('R9', 'final score equals 3 on game-over screen', p.inner_text('#final-score') == '3' and '3' in p.inner_text('#gameover-screen'), p.inner_text('#gameover-screen'))
    check('R9', 'game over screen mentions game over', 'over' in p.inner_text('#gameover-screen').lower())
