    fp.on('console', lambda m: ferr.append(m.text) if m.type in ('error',) else None)
    fp.on('pageerror', lambda e: ferr.append(str(e)))
    fp.goto('file://' + os.path.join(root, 'index.html') + '?manual=1'); fp.wait_for_timeout(500)
    fp.keyboard.press('Enter'); fp.wait_for_timeout(100)
    check('R1', 'opens and starts from file:// without errors', st(fp) == 'playing' and not ferr, ferr)
    ctx.close()

    # ---------- start variants & double start ----------
