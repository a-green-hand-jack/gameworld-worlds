        p = newpage('?manual=1'); start(p); tick(p, 2); g0 = gm(p)
        p.keyboard.press('p'); p.wait_for_timeout(50)
        ok_p = st(p) == 'paused' and p.is_visible('#pause-screen')
        tick(p, 0)
        if how == 'click': p.click('#pause-screen')
        else: p.keyboard.press(how)
        p.wait_for_timeout(50); g1 = gm(p)
        check('R2', 'pause then resume with %r: same run continues (not restarted)' % how, ok_p and st(p) == 'playing' and g1['snake'] == g0['snake'] and g1['score'] == g0['score'], (st(p),))
        p.context.close()
    p = newpage('?manual=1'); start(p); p.keyboard.press('p'); p.keyboard.press('ArrowUp'); p.keyboard.press('p'); tick(p)
    check('R3', 'arrow pressed while paused does not turn', gm(p)['dir'] == 'right')
    p.context.close()

    # layout at several viewports: HUD + board + screens fully inside the window, no scroll
    JS_BOX = """() => { const r = s => { const e = document.querySelector(s); const q = e.getBoundingClientRect(); return [q.top, q.bottom, q.left, q.right]; };
      return {game: r('#game'), hud: r('#hud'), wrap: r('#board-wrap'), sy: scrollY, sh: document.documentElement.scrollHeight}; }"""
    def inside(b, vw, vh): return b[0] >= -0.5 and b[1] <= vh + 0.5 and b[2] >= -0.5 and b[3] <= vw + 0.5
    def screen_fit(p, sel):
        return p.evaluate("""(sel) => { const s = document.querySelector(sel); const w = document.getElementById('board-wrap').getBoundingClientRect();
          const bad = []; for (const c of s.querySelectorAll('*')) { if (c.offsetParent === null) continue; const q = c.getBoundingClientRect();
            if (q.width && (q.top < w.top - 0.5 || q.bottom > w.bottom + 0.5 || q.left < w.left - 0.5 || q.right > w.right + 0.5)) bad.push(c.tagName + '#' + c.id); } return bad; }""", sel)
    for vw, vh in [(1280, 720), (1366, 650), (1366, 768), (1024, 600), (800, 600), (800, 500), (1920, 1080), (500, 700)]:
        p = newpage('?manual=1', viewport=(vw, vh))
        bt = screen_fit(p, '#title-screen'); shot(p, '07-%dx%d-title' % (vw, vh))
        start(p); b = p.evaluate(JS_BOX)
        check('R1', 'title/HUD/board fully inside %dx%d, no scroll, title text within board' % (vw, vh), inside(b['game'], vw, vh) and inside(b['hud'], vw, vh) and b['sy'] == 0 and b['sh'] <= vh and not bt, (b, bt))
        check('R8', 'HUD score visible at %dx%d' % (vw, vh), p.is_visible('#hud') and p.evaluate("() => { const q = document.getElementById('score').getBoundingClientRect(); return q.top >= 0 && q.bottom <= innerHeight; }"))
        shot(p, '07-%dx%d-playing' % (vw, vh))
        p.keyboard.press('p'); bp = screen_fit(p, '#pause-screen'); shot(p, '07-%dx%d-paused' % (vw, vh)); p.keyboard.press('p')
        while st(p) == 'playing': tick(p)
        bg = screen_fit(p, '#gameover-screen'); b2 = p.evaluate(JS_BOX)
        check('R9', 'game-over screen fits inside board at %dx%d, final score visible, no scroll' % (vw, vh), not bg and not bp and inside(b2['game'], vw, vh) and b2['sy'] == 0 and p.is_visible('#final-score'), (bg, bp))
        shot(p, '07-%dx%d-gameover' % (vw, vh))
        p.context.close()
    # canvas stays square and cells aligned when scaled
    p = newpage('?manual=1', viewport=(800, 500)); start(p)
    r = p.eval_on_selector('#board', 'e => { const q = e.getBoundingClientRect(); return [q.width, q.height]; }')
    check('R2', 'board remains square when scaled to 800x500', abs(r[0] - r[1]) < 1, r); p.context.close()
    br.close()

json.dump(results, open(os.path.join(out, 'results.json'), 'w'), indent=1)
bad = [r for r in results if not r['ok']]
print('%d/%d passed' % (len(results) - len(bad), len(results)))
sys.exit(1 if bad else 0)
