import asyncio
from playwright.async_api import async_playwright
OUT='/hutian/repo/evidence/build-3/'
KEY={'up':'ArrowUp','down':'ArrowDown','left':'ArrowLeft','right':'ArrowRight'}
async def main():
    async with async_playwright() as pw:
        b=await pw.chromium.launch()
        res=[]
        # four wall sides
        p=await b.new_page(viewport={'width':1280,'height':800})
        errs=[]; p.on('console',lambda m: errs.append(m.text) if m.type in('error','warning') else None); p.on('pageerror',lambda e: errs.append(str(e)))
        await p.goto('http://localhost:8000/')
        for first,second in [('up',None),('down',None),('left','up'),('right',None)]:
            await p.keyboard.press('Enter'); await asyncio.sleep(0.05)
            if first=='left':
                await p.keyboard.press('ArrowUp'); await asyncio.sleep(0.1); await p.keyboard.press('ArrowLeft')
            else:
                await p.keyboard.press(KEY[first])
            for _ in range(60):
                await asyncio.sleep(0.1)
                s=await p.evaluate("__snake.state")
                if s=='gameover': break
            r=await p.evaluate("[__snake.game.reason,__snake.game.head||__snake.game.snake[0],__snake.game.dir]")
            res.append((first,s,r))
            await p.screenshot(path=OUT+f'09-wall-{first}.png') if first in('left','down') else None
        print(res)
        # tail chase: snake len3 loops in 2x2? needs len 4 for 2x2 loop: skip; test via logic
        r=await p.evaluate("""()=>{const L=SnakeLogic;const g=L.createGame({length:4});
          // 2x2 loop: head right,down,left,up with len4 should survive (tail vacates)
          const out=[];for(const d of ['down','left','up','right','down']){L.turn(g,d);L.step(g);out.push(g.over)};return out}""")
        print('2x2 loop survives (tail-follow):',r)
        # small viewports
        for w,h in [(1920,1080),(1366,768),(1024,600),(800,500),(640,480)]:
            await p.set_viewport_size({'width':w,'height':h}); await asyncio.sleep(0.3)
            d=await p.evaluate("()=>{const r=document.getElementById('board').getBoundingClientRect();const h=document.getElementById('hud').getBoundingClientRect();return {board:[Math.round(r.top),Math.round(r.bottom),Math.round(r.left),Math.round(r.right),Math.round(r.width)],hud:[Math.round(h.top),Math.round(h.bottom)],inner:[innerWidth,innerHeight],scrollH:document.documentElement.scrollHeight,scrollY}}")
            print('viewport',w,h,'board top,bottom,width,innerH,scrollH',d)
            await p.screenshot(path=OUT+f'10-viewport-{w}x{h}.png')
        # blur pause
        await p.set_viewport_size({'width':1280,'height':800})
        await p.keyboard.press('Enter'); await asyncio.sleep(0.1)
        await p.evaluate("window.dispatchEvent(new Event('blur'))"); await asyncio.sleep(0.2)
        print('blur ->',await p.evaluate('__snake.state'))
        print('errors',errs)
        await b.close()
asyncio.run(main())
