"""Generates every file under assets/. Run: python3 tools/make_assets.py"""
import json, math, wave, struct, os
import numpy as np
from PIL import Image, ImageDraw, ImageFont


import subprocess
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "assets")
IMG, AUD = os.path.join(OUT, "images"), os.path.join(OUT, "audio")
os.makedirs(IMG, exist_ok=True); os.makedirs(AUD, exist_ok=True)
C = 32; S = 8  # cell px, supersample
P = dict(bg="#101820", tile="#15212b", body="#4fbf5f", body_dk="#2f8f45", head="#7bd36b",
         eye="#101820", food="#e0533b", food_hl="#ffb3a3", leaf="#f0c05a", text="#f0f0e0")
FONT = os.path.join(OUT, "fonts", "PressStart2P-Regular.ttf")

def save(im, name):
    im.resize((im.width // S, im.height // S), Image.LANCZOS).save(os.path.join(IMG, name))
def canvas(w=C, h=C, col=None):
    return Image.new("RGBA", (w * S, h * S), col or (0, 0, 0, 0))
def rr(d, box, r, fill):
    d.rounded_rectangle([v * S for v in box], r * S, fill=fill)

# tile: opaque, subtle, 1px darker edge on two sides so the grid reads
im = canvas(col=P["tile"]); d = ImageDraw.Draw(im)
d.rectangle([0, 0, C * S - 1, S - 1], fill="#18262f"); d.rectangle([0, 0, S - 1, C * S - 1], fill="#18262f")
save(im, "tile.png")

# body: horizontal, full-width so it tiles with head and tail
im = canvas(); d = ImageDraw.Draw(im)
d.rectangle([0, 4 * S, C * S, 28 * S], fill=P["body_dk"]); d.rectangle([0, 5 * S, C * S, 25 * S], fill=P["body"])
d.rectangle([0, 8 * S, C * S, 11 * S], fill="#6fd47c")
save(im, "snake_body.png")

# head facing right: body-height bar continuing from the left, rounded nose on the right, eyes top/bottom
im = canvas(); d = ImageDraw.Draw(im)
d.rectangle([0, 4 * S, 12 * S, 28 * S], fill=P["body_dk"]); d.rectangle([0, 5 * S, 12 * S, 25 * S], fill=P["head"])
rr(d, (3, 3, 31, 29), 9, P["body_dk"]); rr(d, (3, 4, 31, 26), 9, P["head"])
d.rectangle([0, 4 * S, 6 * S, 28 * S], fill=P["body_dk"]); d.rectangle([0, 5 * S, 6 * S, 25 * S], fill=P["head"])
for y in (10, 22):
    d.ellipse([19 * S, (y - 4) * S, 27 * S, (y + 3) * S], fill="white")
    d.ellipse([22 * S, (y - 3) * S, 27 * S, (y + 2) * S], fill=P["eye"])
save(im, "snake_head.png")

# tail pointing left: tapers from body width (right edge) to a rounded tip
im = canvas(); d = ImageDraw.Draw(im)
d.polygon([(2 * S, 16 * S), (14 * S, 4 * S), (32 * S, 4 * S), (32 * S, 28 * S), (14 * S, 28 * S)], fill=P["body_dk"])
d.polygon([(4 * S, 16 * S), (14 * S, 5 * S), (32 * S, 5 * S), (32 * S, 25 * S), (14 * S, 26 * S)], fill=P["body"])
d.ellipse([1 * S, 14 * S, 5 * S, 18 * S], fill=P["body_dk"])
save(im, "snake_tail.png")

# food: apple, ~24px visible, centred
im = canvas(); d = ImageDraw.Draw(im)
d.ellipse([4 * S, 7 * S, 28 * S, 30 * S], fill=P["food"])
d.ellipse([8 * S, 11 * S, 13 * S, 16 * S], fill=P["food_hl"])
d.polygon([(15 * S, 9 * S), (17.5 * S, 9 * S), (19.5 * S, 3 * S), (17.5 * S, 3 * S)], fill=P["leaf"])
save(im, "food.png")

# title 512x160
W, H = 512, 160
im = canvas(W, H); d = ImageDraw.Draw(im)
f = ImageFont.truetype(FONT, 72 * S) if os.path.exists(FONT) else ImageFont.load_default()
d.text((W * S / 2 + 4 * S, 62 * S + 4 * S), "SNAKE", font=f, fill=P["body_dk"], anchor="mm")
d.text((W * S / 2, 62 * S), "SNAKE", font=f, fill=P["head"], anchor="mm")
for i in range(15):
    y = 134 + 6 * math.sin(i * 0.8)
    r = 7 if i < 14 else 9
    d.ellipse([(24 + i * 32 - r) * S, (y - r) * S, (24 + i * 32 + r) * S, (y + r) * S], fill=P["body"] if i < 14 else P["head"])
save(im, "title.png")

# ---------- audio ----------
SR = 44100
def write(name, x):
    x = np.asarray(x, dtype=np.float64); x = x / max(1e-9, np.abs(x).max()) * 0.7
    n = int(0.003 * SR); x[:n] *= np.linspace(0, 1, n); x[-n:] *= np.linspace(1, 0, n)
    wav = os.path.join(AUD, name + ".wav")
    with wave.open(wav, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(SR)
        w.writeframes(b"".join(struct.pack("<h", int(v * 32767)) for v in x))
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", wav, "-codec:a", "libmp3lame", "-b:a", "96k", os.path.join(AUD, name + ".mp3")], check=True)
    os.remove(wav)
def tone(f0, f1, dur, env=6):
    t = np.arange(int(dur * SR)) / SR
    ph = 2 * np.pi * np.cumsum(f0 + (f1 - f0) * t / dur) / SR
    return (np.sign(np.sin(ph)) * 0.6 + np.sin(ph) * 0.4) * np.exp(-env * t / dur)
write("eat", np.concatenate([tone(520, 520, 0.05, 1.5), tone(780, 1040, 0.1, 4)]))
write("game_over", np.concatenate([tone(392, 370, 0.16, 1.5), tone(311, 294, 0.16, 1.5), tone(233, 130, 0.45, 3)]))
write("start", np.concatenate([tone(392, 392, 0.08, 1.5), tone(523, 523, 0.08, 1.5), tone(659, 659, 0.16, 3)]))

json.dump({"background": P["bg"], "text": P["text"], "accent": P["head"], "danger": P["food"],
           "font": "\"Press Start 2P\", monospace", "fontFile": "assets/fonts/PressStart2P-Regular.ttf"},
          open(os.path.join(OUT, "theme.json"), "w"), indent=2)
