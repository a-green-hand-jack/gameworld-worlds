import asyncio, json, sys, time
from playwright.async_api import async_playwright
OUT='/hutian/repo/evidence/build-1/'
log=[]
def L(*a):
    s=' '.join(str(x) for x in a); print(s); log.append(s)
async def st(p):
    return await p.evaluate("()=>({s:__snake.state,score:document.getElementById('score').textContent,best:document.getElementById('best').textContent,g:__snake.game&&{len:__snake.game.snake.length,dir:__snake.game.dir,score:__snake.game.score,over:__snake.game.over,reason:__snake.game.reason,head:__snake.game.snake[0],food:__snake.game.food,body:__snake.game.snake}})")
KEY={'up':'ArrowUp','down':'ArrowDown','left':'ArrowLeft','right':'ArrowRight'}
OPP={'up':'down','down':'up','left':'right','right':'left'}
async def steer_to_food(p, until_len=None, until_score=None, shots=None, timeout=90):
    t0=time.time(); lastturn=None
    while time.time()-t0<timeout:
        s=await st(p)
        if s['s']!='playing': return s
        g=s['g']
        if until_score is not None and g['score']>=until_score: return s
        h,f,d=g['head'],g['food'],g['dir']
        want=None
        occ={(c['x'],c['y']) for c in g['body'][:-1]}
        def ok(dr):
            dx,dy={'up':(0,-1),'down':(0,1),'left':(-1,0),'right':(1,0)}[dr]
            n=(h['x']+dx,h['y']+dy)
            return 0<=n[0]<20 and 0<=n[1]<20 and n not in occ and dr!=OPP[d]
        pref=[]
        if f['x']>h['x']: pref.append('right')
        if f['x']<h['x']: pref.append('left')
        if f['y']>h['y']: pref.append('down')
        if f['y']<h['y']: pref.append('up')
        pref+= [d]+['up','down','left','right']
        for dr in pref:
            if ok(dr): want=dr;break
        if want and want!=d:
            await p.keyboard.press(KEY[want]); 
        await asyncio.sleep(0.03)
    return await st(p)
