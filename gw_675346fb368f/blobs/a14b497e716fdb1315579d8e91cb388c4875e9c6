"""Playtester's keyboard-only play of the Pong build. Usage: play.py GAME_DIR PROFILE MATCHES OUT_DIR
PROFILE: casual (follows the ball's current y with 200 ms reaction delay), good (anticipates, 100 ms delay), idle."""
import sys, time, json, pathlib, random, collections
from playwright.sync_api import sync_playwright
game, profile, n, out = pathlib.Path(sys.argv[1]).resolve(), sys.argv[2], int(sys.argv[3]), pathlib.Path(sys.argv[4])
out.mkdir(parents=True, exist_ok=True)
rng = random.Random(1)
log = []
def note(m):
    print(f"[{profile}] {m}", flush=True); log.append(m)

with sync_playwright() as p:
    b = p.chromium.launch()
    page = b.new_page(viewport={"width": 1024, "height": 768})
    errors = []
    page.on("pageerror", lambda e: errors.append(str(e)))
    page.on("console", lambda m: errors.append(m.text) if m.type in ("error", "warning") else None)
    page.on("requestfailed", lambda r: errors.append("requestfailed " + r.url))
    page.goto((game / "index.html").as_uri())
    page.wait_for_function("window.pong && pong.getState().screen === 'title'", timeout=10000)
    st = lambda: page.evaluate("pong.getState()")
    page.screenshot(path=str(out / f"{profile}-title.png"))
    results = []
    for m in range(n):
        page.keyboard.press("Space" if m % 2 else "Enter")
        assert st()["screen"] == "play" and st()["score"] == {"player": 0, "cpu": 0}, st()
        t0 = time.time(); held = None; hist = collections.deque(); shots = set(); last_score = (0, 0)
        stuck_since = None; maxrally = 0; stuck = False
        while True:
            s = st()
            if s["screen"] != "play" or time.time() - t0 > 400: break
            now = time.time(); hist.append((now, s))
            sc = (s["score"]["player"], s["score"]["cpu"])
            if sc != last_score:
                note(f"match {m+1}: score {sc[0]}-{sc[1]} at {now-t0:.0f}s"); last_score = sc
                if m == 0 and sc[0] + sc[1] in (1, 3): page.screenshot(path=str(out / f"{profile}-score-{sc[0]}-{sc[1]}.png"))
            if m == 0 and "play" not in shots and now - t0 > 6: page.screenshot(path=str(out / f"{profile}-play.png")); shots.add("play")
            bl = s["ball"]
            if abs(bl["vx"]) < 1 and abs(bl["vy"]) < 1:
                stuck_since = stuck_since or now
                if now - stuck_since > 2.5: stuck = True
            else: stuck_since = None
            maxrally = max(maxrally, s["rallies"])
            delay = 0.2 if profile == "casual" else 0.1
            while len(hist) > 1 and hist[1][0] <= now - delay: hist.popleft()
            d = hist[0][1]; c = s["player"]["y"] + 48; bl = d["ball"]
            if profile == "idle": want = None
            elif profile == "casual":
                target = bl["y"] + 8 + rng.uniform(-20, 20) if bl["vx"] < 0 else 300
                want = "ArrowUp" if target < c - 25 else "ArrowDown" if target > c + 25 else None
            else:
                if bl["vx"] < 0:
                    y = bl["y"] + bl["vy"] * ((bl["x"] - 40) / -bl["vx"]); span = 584
                    y %= 2 * span; y = 2 * span - y if y > span else y
                    target = y + 8 + rng.uniform(-14, 14)
                else: target = 300
                want = "ArrowUp" if target < c - 10 else "ArrowDown" if target > c + 10 else None
            if want != held:
                if held: page.keyboard.up(held)
                if want: page.keyboard.down(want)
                held = want
            time.sleep(0.03)
        if held: page.keyboard.up(held)
        s = st()
        assert s["screen"] == "over", s
        res = dict(match=m + 1, winner=s["winner"], score=[s["score"]["player"], s["score"]["cpu"]], secs=round(time.time() - t0), longest_rally_hits=maxrally, ball_stuck=stuck)
        results.append(res); note(json.dumps(res))
        # F1: mash the confirm keys during the first 0.8 s of the end screen; the winner screen must stay
        t1 = time.time(); locked_seen = False; mashed = 0
        page.screenshot(path=str(out / f"{profile}-over-{m+1}-t0.png"))
        while time.time() - t1 < 0.8:
            page.keyboard.press("Enter" if mashed % 2 else "Space"); mashed += 1; time.sleep(0.08)
            s2 = st(); locked_seen |= s2.get("endLocked", False)
            assert s2["screen"] == "over", ("end screen skipped by key mashing", s2)
        note(f"match {m+1}: mashed Enter/Space {mashed}x in 0.8s after the end; still on end screen (endLocked seen: {locked_seen})")
        time.sleep(0.5)  # lock over, prompt should be steady
        page.screenshot(path=str(out / f"{profile}-over-{m+1}.png"))
        if m == n - 1 and profile == "casual":
            page.keyboard.press("Escape"); assert st()["screen"] == "title"; note("Esc on end screen -> title OK")
            page.screenshot(path=str(out / f"{profile}-back-to-title.png"))
    note("console/page errors: " + json.dumps(errors))
    (out / f"{profile}-log.json").write_text(json.dumps(dict(results=results, errors=errors, log=log), indent=1))
    b.close()
